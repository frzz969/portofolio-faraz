---
// ABOUT - section putih. Copy personal 3 kalimat dari owner dipertahankan
// utuh. Kiri: angka '02' raksasa + quote; kanan: narasi. Garis 1px var(--border).
---

<section class="section section--about" id="about" data-parallax-host>
  <div class="container">
    <div class="section-head section-enter section-enter--left">
      <div>
        <span class="eyebrow"><span class="eyebrow__num">02</span> / Background</span>
        <h2 class="h2">A Little About My Journey</h2>
      </div>
      <p class="mono section-head__note">Authenticity / Practical Foundation / Continuous Evolution</p>
    </div>

    <div class="about__grid">
      <div class="about__quote section-enter section-enter--left">
        <span class="num about__num" aria-hidden="true">02</span>
        <blockquote>
          Never minimize potential, never exaggerate experience. Build ground-up technical
          competence with relentless curiosity.
        </blockquote>
        <p class="body">
          I am driven by practical problems where analytical thinking, structured systems,
          and emerging automated tools intersect. Every endeavor starts with solid
          fundamentals and disciplined execution.
        </p>
      </div>

      <div class="about__text section-enter section-enter--left" style="--stagger:1">
        <p class="lead">
          I started with hardware, not theory: four months at Soerya Global Komputer fixing
          PCs and printers, installing systems, and writing down each fix so the next person
          could repeat it.
        </p>
        <p class="body">
          That habit carried into AI. Today I build with language models, evaluate Indonesian
          text, and automate workflows, always checking how the system behaves before trusting
          it.
        </p>
        <p class="body">
          Looking for work where infrastructure, data, and language meet practical problems.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* Nomor section memakai signature Projects: biru sebagai hairline 1px,
     bukan badge. Teks label tetap mono netral (R-31). */
  .eyebrow__num {
    position: relative;
    color: var(--accent);
  }
  .eyebrow__num::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -6px;
    width: 28px;
    height: 1px;
    background: var(--accent);
  }

  .about__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
  }
  .about__quote {
    position: relative;
    padding: 40px 28px 28px;
    background: var(--white);
    border-top: 1px solid var(--strong);
    border-bottom: 1px solid var(--strong);
  }
  /* Angka adalah elemen visual, bukan label; kontras via var(--muted). */
  .about__num {
    display: block;
    position: relative;
    font-size: clamp(5rem, 12vw, 7.5rem);
    line-height: 0.85;
    margin-bottom: 24px;
  }
  .about__quote blockquote {
    position: relative;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.6vw, 1.875rem);
    font-weight: 700;
    line-height: 1.22;
    letter-spacing: -0.035em;
    max-width: 26ch;
    margin-bottom: 24px;
    color: var(--black);
  }
  .about__text > p + p { margin-top: 20px; }
  .about__text { max-width: 62ch; }

  @media (min-width: 900px) {
    .about__grid {
      grid-template-columns: minmax(280px, 0.9fr) minmax(0, 1.1fr);
      gap: clamp(56px, 8vw, 104px);
      align-items: start;
    }
    .about__quote { padding: 48px 40px 36px; }
    /* Narasi lebih panjang dari visual: garis 1px memisahkan tiap langkah,
       sehingga visual kiri sempat benar-benar sticky saat dibaca (R-31). */
    .about__text > p { padding-block: 18px; }
    .about__text > p + p {
      margin-top: 24px;
      border-top: 1px solid var(--strong);
    }
  }
</style>
