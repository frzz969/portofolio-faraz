---
// CONTACT: dark #191D26, lanjutan langsung ke footer. SATU CTA primer
// (email). Semua tautan lain secondary. Copy email tetap fungsional.
const email = 'farasfirdaus564@gmail.com';
const phone = '+62 882-3834-9814';
const waLink = 'https://wa.me/6288238349814?text=Halo%20Faras%2C%20saya%20ingin%20diskusi%20tentang%20kolaborasi%20atau%20proyek.';
const arrangements = ['Remote', 'Work from anywhere', 'Hybrid', 'On-site in Indonesia'];
---

<section class="contact charcoal" id="contact">
  <div class="container">
    <div class="contact__head">
      <span class="eyebrow"><span class="eyebrow__num">06</span> / Contact</span>
      <h2 class="h2 contact__title">
        <span class="cta-line" style="--i:0">Have a project or</span>
        <span class="cta-line" style="--i:1">opportunity in mind?</span>
      </h2>
      <p class="lead">
        I am interested in learning, collaborating, and contributing to meaningful work.
        AI research, language tasks, remote administration, or technology initiatives.
        If it is practical and worth doing carefully, I am open to exploring it.
      </p>

      <!-- SATU CTA primer: email. Tautan lain sengaja secondary. -->
      <a class="btn btn--light contact__primary" href={`mailto:${email}?subject=Kolaborasi%20Portofolio%20Faras&body=Halo%20Faras%2C%20nama%20saya%20...`}>
        Start an email
        <svg class="icon icon--arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10" /><path d="M7 17 17 7" /></svg>
      </a>
    </div>

    <div class="contact__grid">
      <div class="contact__arrangements">
        <span class="meta-label">Work arrangements</span>
        <ul class="contact__chips">
          {arrangements.map((item) => <li class="mono">{item}</li>)}
        </ul>
      </div>

      <div class="contact__direct">
        <span class="meta-label">Elsewhere</span>
        <ul class="contact__links">
          <li>
            <a class="contact__link contact__link--email" href={`mailto:${email}`}>
              <span class="contact__label mono"><svg class="icon contact__icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7" /><rect x="2" y="4" width="20" height="16" rx="2" /></svg>Email</span>
              <span class="contact__value">{email}</span>
            </a>
          </li>
          <li>
            <a class="contact__link" href={waLink} target="_blank" rel="noopener noreferrer">
              <span class="contact__label mono"><svg class="icon contact__icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719" /></svg>WhatsApp</span>
              <span class="contact__value">{phone}</span>
            </a>
          </li>
          <li>
            <a class="contact__link" href="https://github.com/farasfadhil" target="_blank" rel="noopener noreferrer">
              <span class="contact__label mono"><svg class="icon contact__icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 17H7A5 5 0 0 1 7 7h2" /><path d="M15 7h2a5 5 0 1 1 0 10h-2" /><line x1="8" x2="16" y1="12" y2="12" /></svg>GitHub</span>
              <span class="contact__value">github.com/farasfadhil</span>
            </a>
          </li>
          <li>
            <a class="contact__link" href="https://linkedin.com/in/faras-fadhil-firdaus" target="_blank" rel="noopener noreferrer">
              <span class="contact__label mono"><svg class="icon contact__icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 17H7A5 5 0 0 1 7 7h2" /><path d="M15 7h2a5 5 0 1 1 0 10h-2" /><line x1="8" x2="16" y1="12" y2="12" /></svg>LinkedIn</span>
              <span class="contact__value">linkedin.com/in/faras-fadhil-firdaus</span>
            </a>
          </li>
        </ul>
        <button class="btn btn--outline-light contact__copy" id="copyEmailBtn" type="button">
          <svg class="icon contact__icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2" /><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" /></svg>
          <span id="copyBtnText">Copy email address</span>
        </button>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ email }}>
  const btn = document.getElementById('copyEmailBtn');
  const label = document.getElementById('copyBtnText');
  // Fallback untuk konteks tanpa Clipboard API: tetap menyalin, bukan hanya
  // menampilkan alamat. Label tombol diperbarui agar hasilnya terdengar.
  const fallbackCopy = () => {
    const field = document.createElement('textarea');
    field.value = email;
    field.setAttribute('readonly', '');
    field.style.position = 'fixed';
    field.style.opacity = '0';
    document.body.appendChild(field);
    field.select();
    const ok = document.execCommand('copy');
    field.remove();
    return ok;
  };
  btn?.addEventListener('click', async () => {
    let copied = false;
    if (navigator.clipboard?.writeText) {
      try {
        await navigator.clipboard.writeText(email);
        copied = true;
      } catch { /* lanjut ke fallback */ }
    }
    if (!copied) copied = fallbackCopy();
    if (label) label.textContent = copied ? 'Copied to clipboard' : email;
    btn?.setAttribute('aria-label', copied ? 'Email address copied' : `Email address: ${email}`);
  });
</script>

<style>
  /* Nomor putih di dark surface; hairline biru 1px, bukan badge. */
  .eyebrow__num {
    position: relative;
    color: var(--white);
  }
  .eyebrow__num::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -6px;
    width: 28px;
    height: 1px;
    background: var(--accent);
  }

  .contact { padding-block: clamp(80px, 11vw, 140px) clamp(56px, 8vw, 88px); }
  .contact__head { max-width: 100%; min-width: 0; }

  /* Ikon Lucide: 16px, mengikuti warna teks. Label tetap berupa teks. */
  .icon {
    display: inline-block;
    flex: none;
    width: 16px;
    height: 16px;
    vertical-align: -3px;
  }
  .icon--arrow { width: 18px; height: 18px; }
  .contact__label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .contact__icon { color: var(--muted); }
  .contact__link:hover .contact__icon,
  .contact__link:focus-visible .contact__icon { color: var(--white); }
  .contact__copy .contact__icon { color: var(--ink); }
  .contact__copy:hover .contact__icon { color: var(--white); }
  /* Headline 32-48px desktop, dua baris disengaja, kata tidak dipecah.
     Floor lebih kecil di 360px menjaga tanpa overflow (R-31). */
  .contact__title {
    margin-block: 20px 28px;
    font-size: clamp(1.75rem, 4vw, 3rem);
    line-height: 1.1;
    overflow-wrap: normal;
    word-break: keep-all;
    hyphens: none;
  }
  .contact__title .cta-line { display: block; color: var(--white); }
  .contact .lead { max-width: 60ch; }
  /* Satu CTA primer: teks gelap di atas putih, fokus putih di dark surface. */
  .contact__primary { margin-top: 32px; }
  .contact__primary:focus-visible { outline: 2px solid var(--white); outline-offset: 3px; }
  @media (hover: hover) and (pointer: fine) {
    .contact__primary:hover {
      background: var(--white);
      border-color: var(--white);
      color: var(--black);
      transform: translateY(-1px);
    }
  }
  .contact__primary:active { transform: translateY(1px); }
  .contact__primary .arrow-glyph { transition: transform var(--dur-ui) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .contact__primary:hover .arrow-glyph { transform: translate(2px, -2px); }
  }
  .contact__copy:focus-visible { outline: 2px solid var(--white); outline-offset: 3px; }
  .contact__copy:active { transform: translateY(1px); }
  .contact__link:focus-visible { outline: 2px solid var(--white); outline-offset: 2px; }
  .contact__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    margin-top: clamp(56px, 8vw, 96px);
    padding-top: 32px;
    border-top: 1px solid var(--strong);
  }
  .contact__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 20px;
    margin-top: 16px;
    color: var(--muted);
  }
  .contact__chips li { border-bottom: 1px solid var(--strong); padding-bottom: 2px; }
  .contact__links {
    margin-top: 16px;
    border-top: 1px solid var(--strong);
  }
  .contact__link {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4px;
    min-height: 56px;
    padding-block: 12px;
    border-bottom: 1px solid var(--strong);
    transition: padding-left var(--dur-ui) var(--ease-out);
  }
  .contact__link:hover { padding-left: 8px; }
  .contact__link:focus-visible { outline-color: var(--white); }
  .contact__label { color: var(--muted); }
  .contact__value {
    font-size: 0.9375rem;
    color: var(--white);
    overflow-wrap: anywhere;
  }
  .contact__link--email .contact__value {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.125rem, 2.2vw, 1.5rem);
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  .contact__copy { margin-top: 24px; }

  @media (min-width: 768px) {
    .contact__grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: clamp(48px, 6vw, 96px);
    }
    .contact__link {
      grid-template-columns: 140px 1fr;
      gap: 20px;
    }
  }
</style>
