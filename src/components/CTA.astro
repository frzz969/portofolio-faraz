---
// SECTION 9: CTA / LET'S CONNECT - teks persis dari index.html.
const email = 'farasfirdaus564@gmail.com';
const phone = '+62 882-3834-9814';
const arrangements = ['Remote', 'WFA (Anywhere)', 'Hybrid', 'On-site (ID)'];
---

<style>
  .btn-wa{display:inline-flex;align-items:center;min-height:44px;padding:.7rem 1.1rem;background:#1C1DAB;color:#CBD8E8;text-decoration:none;border-radius:2px;font-weight:600}
  .btn-wa:hover{background:#1C1DAB}
  .contact-lines{margin-top:.75rem;font:.8rem/1.6 ui-monospace,monospace;color:#1E0F75;overflow-wrap:anywhere}
  @media (prefers-color-scheme: dark) {
    .btn-wa{background:#3785D8;color:#1E0F75}
    .btn-wa:hover{background:#C08CE2}
    .contact-lines{color:#CBD8E8}
  }
</style>

<section class="w-full py-20 lg:py-28" id="contact">
  <div class="max-w-[1180px] mx-auto px-margin-mobile lg:px-margin">
    <div class="bg-surface-container p-8 lg:p-16 rounded-xl shadow-md">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7">
          <span class="text-label-sm font-label-sm text-muted-brass uppercase tracking-widest block mb-4 font-mono">08 / INVITATION</span>
          <h2 class="font-display text-display font-bold tracking-tight text-ink leading-[0.95] mb-6 flex flex-col">
            <span class="reveal-line" style="--i:0">OPEN TO</span>
            <span class="reveal-line text-accent-oxblood" style="--i:1">NEW POSSIBILITIES.</span>
          </h2>
          <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed max-w-xl mb-8">
            I'm always interested in learning, collaborating, and contributing to meaningful projects. Whether it's an AI research project, language-related task, remote administrative role, or technology initiative, I'm open to exploring new opportunities.
          </p>
          <div class="mb-8">
            <span class="text-label-sm font-label-sm text-on-surface-variant uppercase tracking-wider block mb-3 font-mono">Work Arrangements:</span>
            <div class="flex flex-wrap gap-2">
              {arrangements.map((item) => (
                <span class="px-3 py-1 rounded bg-surface-container-high text-ink font-label-md text-label-md font-medium">{item}</span>
              ))}
            </div>
          </div>
        </div>
        <div class="lg:col-span-5 bg-surface-container-low p-8 rounded-xl shadow-sm space-y-6">
          <div>
            <span class="text-label-sm font-label-sm text-on-surface-variant uppercase font-mono block mb-1">Direct Inquiries</span>
          </div>
          <button class="btn w-full flex items-center justify-center gap-2 px-5 py-3 rounded-lg bg-accent-oxblood text-paper font-label-md text-label-md hover:bg-primary transition-all duration-200 shadow-sm min-h-[44px]" id="copyEmailBtn" type="button">
            <svg class="w-[1em] h-[1em] inline-block shrink-0 align-middle" viewBox="0 0 24 24" fill="none" stroke="#CBD8E8" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"/></svg>
            <span id="copyBtnText">Copy Email Address</span>
          </button>
          <a class="btn-wa" href="https://wa.me/6288238349814?text=Halo%20Faras%2C%20saya%20ingin%20diskusi%20tentang%20kolaborasi%20atau%20proyek." target="_blank" rel="noopener noreferrer" aria-label="Chat via WhatsApp">Chat WhatsApp ↗</a>
          <p class="contact-lines">{phone} · <a href="mailto:farasfirdaus564@gmail.com?subject=Kolaborasi%20Portofolio%20Faras&body=Halo%20Faras%2C%20nama%20saya%20...">{email}</a></p>
          <div class="pt-6 space-y-3">
            <div class="flex items-center justify-between text-body-sm font-body-sm">
              <span class="text-on-surface-variant">GitHub Profile</span>
              <!-- GANTI: konfirmasi username GitHub -->
              <a class="font-medium text-ink hover:text-accent-oxblood transition-colors inline-flex items-center gap-1" href="https://github.com/farasfadhil" rel="noopener noreferrer" target="_blank">
                <span>github.com/farasfadhil</span>
                <svg class="w-[1em] h-[1em] inline-block shrink-0 align-middle" viewBox="0 0 24 24" fill="none" stroke="#1C1DAB" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
            </div>
            <div class="flex items-center justify-between text-body-sm font-body-sm">
              <span class="text-on-surface-variant">LinkedIn Connection</span>
              <!-- GANTI: konfirmasi slug LinkedIn -->
              <a class="font-medium text-ink hover:text-accent-oxblood transition-colors inline-flex items-center gap-1" href="https://linkedin.com/in/faras-fadhil-firdaus" rel="noopener noreferrer" target="_blank">
                <span>linkedin.com/in/faras-fadhil-firdaus</span>
                <svg class="w-[1em] h-[1em] inline-block shrink-0 align-middle" viewBox="0 0 24 24" fill="none" stroke="#1C1DAB" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
            </div>
            <div class="flex items-center justify-between text-body-sm font-body-sm">
              <span class="text-on-surface-variant">Primary Base</span>
              <span class="font-medium text-ink">Sukoharjo, Jawa Tengah, Indonesia</span>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="w-full max-w-[1180px] mx-auto px-margin-mobile lg:px-margin pb-12 flex flex-col sm:flex-row items-center justify-between gap-4 text-on-surface-variant text-label-sm font-label-sm font-mono">
      <span>Editorial rigor · Grounded authentic portfolio</span>
      <span>Designed with Night Sky (#CBD8E8) &amp; Ink (#1E0F75)</span>
    </div>
  </div>
</section>

<script is:inline define:vars={{ email }}>
  const btn = document.getElementById('copyEmailBtn');
  const label = document.getElementById('copyBtnText');
  btn?.addEventListener('click', () => { navigator.clipboard?.writeText(email); if (label) label.textContent = 'Copied to Clipboard!'; });
</script>
