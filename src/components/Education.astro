---
// EDUCATION & CERTIFICATIONS - kredensial akurat. Status "in issuance"
// dipertahankan apa adanya, tidak diubah jadi "issued".
const certifications = [
  { title: 'MikroTik Certified Network Associate (MTCNA)', detail: 'RouterOS configuration, firewall filters, NAT, queue bandwidth management', badge: 'Issued 2025', pending: false },
  { title: 'BNSP Junior Fiber Optic Cable Jointer', detail: 'National professional competency in fusion splicing and OTDR testing', badge: 'Issued 2026', pending: false },
  { title: 'Practical Office Advance', detail: 'Balai Pelatihan Vokasi dan Produktivitas (BPVP)', badge: 'BPVP 2026', pending: false },
  { title: 'BNSP Practical Office Advance', detail: 'National Vocational Certification Board candidate qualification', badge: 'In issuance / printing process', pending: true },
];
---

<section class="section" id="education">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow">05 / Qualifications</span>
        <h2 class="h2">Education &amp; Certifications</h2>
      </div>
      <p class="mono section-head__note">Formal vocational grounding and validated competencies</p>
    </div>

    <div class="edu__grid">
      <div class="edu__formal reveal">
        <span class="eyebrow">Formal academics</span>
        <h3 class="h3 edu__school">SMK Negeri 1 Sukoharjo</h3>
        <p class="h4">Computer and Network Engineering (TJKT)</p>
        <p class="body edu__desc">
          Three-year vocational curriculum covering enterprise IP routing, LAN switching,
          fiber optic splicing, server administration, operating systems, and client
          hardware engineering.
        </p>
        <div class="edu__period">
          <span class="meta-label">Graduation cycle</span>
          <span class="mono">2022 / 2025</span>
        </div>
      </div>

      <div class="edu__creds">
        <span class="eyebrow">Professional licenses and credentials</span>
        <ul class="edu__list">
          {certifications.map((cert, index) => (
            <li class="edu__item reveal" style={`--stagger:${index}`}>
              <div>
                <h4 class="h4">{cert.title}</h4>
                <p class="body">{cert.detail}</p>
              </div>
              <span class:list={['status', { 'status--pending': cert.pending }]}>{cert.badge}</span>
            </li>
          ))}
        </ul>
        <p class="mono edu__footnote">
          All credentials verifiable via issuing registry IDs upon inquiry.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .edu__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }
  .edu__formal {
    border-top: 1px solid var(--border);
    padding-top: 24px;
  }
  .edu__school { margin-block: 16px 4px; }
  .edu__desc { margin-top: 20px; max-width: 52ch; }
  .edu__period {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-top: 28px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }
  .edu__list {
    margin-top: 20px;
    border-top: 1px solid var(--border);
  }
  .edu__item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding-block: 18px;
    border-bottom: 1px solid var(--border);
  }
  .edu__item .body { font-size: 0.875rem; margin-top: 4px; }
  .edu__footnote { margin-top: 20px; color: var(--subtle); }

  @media (min-width: 768px) {
    .edu__item {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }
  }
  @media (min-width: 900px) {
    .edu__grid {
      grid-template-columns: minmax(260px, 0.8fr) minmax(0, 1.2fr);
      gap: clamp(48px, 6vw, 88px);
    }
  }
</style>
