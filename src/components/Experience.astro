---
import { experiences } from '../data/experience';

// EXPERIENCE - vertical timeline. Tanggal sejajar di kiri, progres mengisi
// saat section masuk viewport (motion.css).
const labels: Record<string, string> = {
  'it-support-intern': 'Vocational internship',
  pmr: 'Activities & logistics',
  'dewan-ambalan': 'Activities & coordination',
};
---

<section class="section" id="experience">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow">04 / Track record</span>
        <h2 class="h2">Experience</h2>
      </div>
      <p class="mono section-head__note">Practical roles and organizational involvement</p>
    </div>

    <div class="timeline reveal">
      <span class="timeline__progress" aria-hidden="true"></span>
      {experiences.map((item, index) => (
        <article class="timeline__item" style={`--stagger:${index}`}>
          <span class="timeline__dot" aria-hidden="true"></span>
          <div class="timeline__date">
            <span class="meta-label">{labels[item.id] ?? 'Role'}</span>
            <time class="mono">{item.period}</time>
          </div>
          <div class="timeline__content">
            <h3 class="h3">{item.role}</h3>
            <p class="h4 timeline__org">{item.organization}</p>
            <ul class="timeline__bullets">
              {item.bullets.map((bullet) => (
                <li class="body">{bullet}</li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .timeline__item {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    padding: 0 0 40px 28px;
  }
  .timeline__item:last-child { padding-bottom: 0; }
  .timeline__dot {
    position: absolute;
    left: 1px;
    top: 8px;
    width: 9px;
    height: 9px;
    background: var(--paper);
    border: 1px solid var(--ink);
  }
  .timeline__date {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .timeline__date .mono { color: var(--subtle); }
  .timeline__org { color: var(--subtle); margin-top: 4px; }
  .timeline__bullets {
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 68ch;
  }
  .timeline__bullets li {
    position: relative;
    padding-left: 18px;
  }
  .timeline__bullets li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 6px;
    height: 1px;
    background: var(--ink);
  }

  @media (min-width: 768px) {
    .timeline__item {
      grid-template-columns: minmax(180px, 0.42fr) minmax(0, 1fr);
      gap: 32px;
      padding-left: 36px;
      padding-bottom: 48px;
    }
    .timeline__dot { left: 1px; }
  }
</style>
