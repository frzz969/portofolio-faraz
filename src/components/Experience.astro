---
import { experiences } from '../data/experience';

// EXPERIENCE - timeline editorial di putih. Tanggal mono di kiri, peran dan
// organisasi di kanan. Garis progresif dan .section-enter dari P3 dipertahankan;
// state "dibaca" memakai .is-reached yang sudah ditulis IO di Layout. Nama
// organisasi Inggris dari data dipertahankan apa adanya (R-31).
const labels: Record<string, string> = {
  'it-support-intern': 'Vocational internship',
  'poa-bpvp': 'Vocational training',
  pmr: 'Activities & logistics',
  'dewan-ambalan': 'Activities & coordination',
};
---

<section class="section section--experience" id="experience">
  <div class="container">
    <div class="section-head section-enter">
      <div>
        <span class="eyebrow"><span class="eyebrow__num">04</span> / Experience</span>
        <h2 class="h2">Experience</h2>
      </div>
      <p class="mono section-head__note">Practical roles and organizational involvement</p>
    </div>

    <div class="timeline section-enter" style="--stagger:1">
      <span class="timeline__progress" aria-hidden="true"></span>
      {experiences.map((item, index) => (
        <article class="timeline__item" style={`--stagger:${index}`}>
          <span class="timeline__dot" aria-hidden="true"></span>
          <div class="timeline__date">
            <span class="timeline__ordinal num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <span class="meta-label">{labels[item.id] ?? 'Role'}</span>
            <time class="mono">{item.period}</time>
          </div>
          <div class="timeline__content">
            <h3 class="h3">{item.role}</h3>
            <p class="h4 timeline__org">{item.organization}</p>
            <ul class="timeline__bullets">
              {item.bullets.map((bullet) => (
                <li class="body">{bullet}</li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* Penanda section: hairline biru 1px, bukan badge (R-31). */
  .eyebrow__num {
    position: relative;
    color: var(--accent);
  }
  .eyebrow__num::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -6px;
    width: 28px;
    height: 1px;
    background: var(--accent);
  }

  .timeline__item {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    padding: 0 0 40px 28px;
  }
  .timeline__item:last-child { padding-bottom: 0; }
  .timeline__dot {
    position: absolute;
    left: 1px;
    top: 8px;
    width: 9px;
    height: 9px;
    background: var(--white);
    border: 1px solid var(--black);
  }
  .timeline__date {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  /* Ordinal adalah penanda urutan baca, bukan data baru: angka diambil dari
     indeks entri yang sudah ada (R-31). */
  .timeline__ordinal {
    font-size: clamp(2.25rem, 4vw, 3rem);
    line-height: 1;
    margin-bottom: 4px;
  }
  .timeline__date .mono { color: var(--strong); }
  .timeline__org { color: var(--strong); margin-top: 4px; }

  /* Item yang sedang dibaca ditekankan dengan kontras penuh (--ink di
     atas permukaan terang), bukan dengan putih yang akan hilang.
     .is-reached berasal dari observer yang sudah ada (R-31). */
  .timeline__item.is-reached .timeline__date .mono,
  .timeline__item.is-reached .timeline__org,
  .timeline__item.is-reached .timeline__ordinal { color: var(--black); }
  .timeline__item.is-reached .timeline__date .meta-label { color: var(--black); }
  .timeline__item .timeline__date .mono,
  .timeline__item .timeline__org,
  .timeline__item .timeline__ordinal {
    transition: color var(--dur-ui) var(--ease-ui);
  }

  .timeline__bullets {
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 68ch;
  }
  .timeline__bullets li {
    position: relative;
    padding-left: 18px;
  }
  .timeline__bullets li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 6px;
    height: 1px;
    background: var(--black);
  }

  @media (min-width: 768px) {
    .timeline__item {
      grid-template-columns: minmax(180px, 0.42fr) minmax(0, 1fr);
      gap: clamp(32px, 5vw, 72px);
      padding-left: 36px;
      padding-bottom: 56px;
    }
    .timeline__dot { left: 1px; }
    /* Kolom tanggal rata kanan: angka dan tanggal menjadi margin editorial,
       konten tetap satu blok yang mudah diikuti. */
    .timeline__date { align-items: flex-end; text-align: right; }
  }
</style>
