---
import { experiences } from '../data/experience';

// SECTION 5: EXPERIENCE - isi dari src/data/experience.ts, struktur dari index.html.
const labels: Record<string, string> = {
  'it-support-intern': 'VOCATIONAL INTERNSHIP',
  'pmr-dewan-ambalan': 'LEADERSHIP & LOGISTICS',
};
---

<section class="w-full py-20 lg:py-28" id="experience">
  <div class="max-w-[1180px] mx-auto px-margin-mobile lg:px-margin">
    <div class="flex flex-col md:flex-row md:items-baseline justify-between mb-14 gap-4">
      <div>
        <span class="text-label-sm font-label-sm text-muted-brass uppercase tracking-widest block mb-2 font-mono">04 / TRACK RECORD</span>
        <h2 class="font-headline-lg text-headline-lg text-ink font-semibold tracking-tight">Experience</h2>
      </div>
      <p class="text-body-sm font-body-sm text-on-surface-variant max-w-xs md:text-right font-mono">
        Verifiable Practical Roles &amp; Organizational Leadership
      </p>
    </div>
    <div class="space-y-6">
      {experiences.map((item) => (
        <div class="card bg-surface-container p-8 lg:p-10 rounded-xl shadow-sm">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="text-label-sm font-label-sm font-mono text-muted-brass uppercase tracking-widest" set:html={labels[item.id]}></span>
              </div>
              <h3 class="font-headline-md text-headline-md text-ink font-semibold">{item.role}</h3>
              <p class="text-title-md font-title-md text-accent-oxblood font-medium">{item.organization}</p>
            </div>
            <div class="inline-flex items-center px-3 py-1 rounded-full bg-surface-container-high text-ink text-label-sm font-label-sm font-mono">
              {item.period}
            </div>
          </div>
          <ul class="space-y-3 max-w-3xl">
            {item.bullets.map((bullet) => (
              <li class="flex items-start gap-3 text-body-md font-body-md text-on-surface-variant">
                <svg class="text-accent-oxblood shrink-0 mt-0.5 w-[1em] h-[1em] inline-block shrink-0 align-middle" viewBox="0 0 24 24" fill="none" stroke="#8C2F39" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 12l2.5 2.5L16 9"/></svg>
                <span>{bullet}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
