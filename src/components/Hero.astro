---
// HERO = cover editorial terang. Satu focal point: nama + positioning jujur.
// Portrait monokrome di kanan dengan frame border 1px; metadata tiga bidang
// di bawah. Tidak ada klaim senior/engineer; sudut pandang sesuai CV.
const fields = ['AI & Technology', 'Digital Operations', 'Technical Research'];
---

<section class="hero" id="hero">
  <div class="hero__rules" aria-hidden="true">
    <span class="hero__rule hero__rule--top"></span>
    <span class="hero__rule hero__rule--bottom"></span>
    <span class="hero__cross hero__cross--tl"></span>
    <span class="hero__cross hero__cross--tr"></span>
    <span class="hero__cross hero__cross--bl"></span>
    <span class="hero__cross hero__cross--br"></span>
  </div>

  <div class="container hero__grid">
    <div class="hero__copy">
      <div class="hero__meta hero-fade hero-fade--meta">
        <span class="hero__meta-cell">FFF / PORTFOLIO 2026</span>
        <span class="hero__meta-cell hero__meta-cell--index">01 / Introduction</span>
      </div>

      <h1 class="h1 hero__headline">
        <span class="hero-line-wrap"><span class="hero-line" style="--i:0">Faras Fadhil</span></span>
        <span class="hero-line-wrap"><span class="hero-line hero-line--headline" style="--i:1">Firdaus</span></span>
      </h1>

      <p class="hero__role hero-fade hero-fade--role">AI &amp; Digital Operations Enthusiast</p>

      <p class="lead hero-fade hero-fade--lead">
        Background in Computer and Network Engineering. I explore practical uses of AI,
        language technologies, and structured digital operations through prototypes and
        ongoing research.
      </p>

      <div class="hero__actions hero-fade hero-fade--actions">
        <a class="btn" href="#projects">Explore My Work</a>
        <a class="btn btn--ghost" href="#contact">Get in Touch</a>
      </div>

      <a class="hero__scroll mono hero-fade hero-fade--scroll" href="#about">SCROLL ↓</a>
    </div>

    <figure class="hero__portrait hero-fade--portrait">
      <div class="hero__portrait-frame">
        <img
          src="./portrait-faras.svg"
          width="800"
          height="1000"
          fetchpriority="high"
          alt="Monochrome editorial portrait of Faras Fadhil Firdaus."
        />
      </div>
      <figcaption class="meta-label">Faras Fadhil Firdaus, 2026</figcaption>
    </figure>
  </div>

  <div class="container hero__fields hero-fade hero-fade--fields">
    <ul class="hero__fields-list">
      {fields.map((field) => <li class="hero__field mono">{field}</li>)}
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: var(--canvas);
    color: var(--ink);
    min-height: 100svh;
    padding-block: clamp(32px, 5vh, 56px) clamp(40px, 6vh, 64px);
  }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 1fr); position: relative; }
  .hero__copy { position: relative; min-width: 0; max-width: 1100px; }

  /* Dua garis 1px + empat mark netral: mengikat metadata ke headline, bukan
     coretan dekoratif. Satu-satunya biru di hero adalah underline role. */
  .hero__rules {
    position: absolute;
    inset: var(--header-h) max(var(--gutter), calc((100% - var(--page-max)) / 2)) 0;
    pointer-events: none;
    overflow: hidden;
  }
  .hero__rule {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--border);
  }
  .hero__rule--top { top: 0; }
  .hero__rule--bottom { bottom: 0; }
  .hero__cross {
    position: absolute;
    width: 9px;
    height: 9px;
    border-color: var(--border);
    border-style: solid;
    border-width: 0;
  }
  .hero__cross--tl { top: 0; left: 0; border-top-width: 1px; border-left-width: 1px; }
  .hero__cross--tr { top: 0; right: 0; border-top-width: 1px; border-right-width: 1px; }
  .hero__cross--bl { bottom: 0; left: 0; border-bottom-width: 1px; border-left-width: 1px; }
  .hero__cross--br { bottom: 0; right: 0; border-bottom-width: 1px; border-right-width: 1px; }

  .hero__meta {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 6px 16px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border);
  }
  .hero__meta-cell { min-width: 0; }
  .hero__meta-cell--index { text-align: right; }

  /* 56-88px desktop, tidak memecah kata, turun rapi di 360px. */
  .hero__headline {
    margin-block: 28px 16px;
    color: var(--ink);
    font-size: clamp(3.5rem, 6.2vw, 5.5rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
    overflow-wrap: normal;
    word-break: keep-all;
    hyphens: none;
  }
  .hero-line-wrap { display: block; }
  .hero-line { display: block; }

  .hero__role {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding-block: 4px;
    border-top: 1px solid var(--accent);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .hero .lead { color: var(--muted); max-width: 60ch; margin-top: 20px; }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  /* Portrait: frame editorial datar, 1px border, tanpa shadow. Di layar
     sempit turun di bawah copy; caption melekat pada frame. */
  .hero__portrait { margin: 32px 0 0; width: min(100%, 240px); min-width: 0; }
  .hero__portrait-frame {
    background: var(--secondary-surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }
  .hero__portrait-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.06);
  }
  .hero__portrait figcaption {
    margin-top: 8px;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-align: left;
    color: var(--muted);
  }

  /* Tiga bidang, mono kecil, dipisah garis 1px, bukan badge capsule. */
  .hero__fields {
    margin-top: clamp(24px, 4vh, 40px);
  }
  .hero__fields-list {
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--border);
  }
  .hero__field {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding-block: 10px;
    border-bottom: 1px solid var(--border);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .hero__scroll {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 16px;
    color: var(--muted);
    letter-spacing: 0.14em;
  }
  .hero__scroll:hover { color: var(--accent); }

  @media (min-width: 600px) {
    .hero__meta { grid-template-columns: repeat(2, auto); justify-content: space-between; }
    .hero__fields-list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .hero__field { padding-inline: 16px; border-left: 1px solid var(--border); }
    .hero__field:first-child { padding-left: 0; border-left: 0; }
  }

  @media (min-width: 900px) {
    /* Split nyata: copy dan portrait adalah dua kolom grid, bukan overlay.
       Portrait tidak bisa menimpa baris fields karena berada di alur grid
       dan tingginya dibatasi; transform pointer tetap <=6px. */
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 260px);
      column-gap: clamp(40px, 5vw, 80px);
      align-items: start;
    }
    .hero__copy { grid-column: 1; grid-row: 1; }
    .hero__portrait {
      grid-column: 2;
      grid-row: 1;
      width: 100%;
      max-width: 260px;
      margin: 0;
      transform: translate3d(var(--hero-px, 0px), var(--hero-py, 0px), 0);
      will-change: transform;
    }
  }

  @media (max-width: 420px) {
    .hero__actions .btn { flex: 1 1 100%; }
    .hero__meta { font-size: 0.75rem; letter-spacing: 0.08em; }
    .hero__headline { font-size: clamp(3rem, 13vw, 3.5rem); }
  }
</style>
