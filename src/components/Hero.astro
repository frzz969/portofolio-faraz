---
// HERO - copy Faras dipertahankan, dipadatkan jadi intro singkat.
// Focal point tunggal: headline. Portrait bersifat opsional dan netral.
---

<section class="container hero" id="hero">
  <div class="hero__grid">
    <div class="hero__copy">
      <p class="eyebrow hero-fade">Technology Enthusiast / AI-Assisted Developer</p>

      <h1 class="h1 hero__headline">
        <span class="hero-line" style="--i:0">EXPLORING AI.</span>
        <span class="hero-line hero-line--quiet" style="--i:1">BUILDING IDEAS.</span>
        <span class="hero-line" style="--i:2">CREATING IMPACT.</span>
      </h1>

      <p class="lead hero-fade">
        Background in Computer and Network Engineering. I work at the intersection of
        artificial intelligence, software development, language technologies, and
        digital operations, building practical solutions with AI-assisted workflows.
      </p>

      <div class="hero__actions hero-fade">
        <a class="btn" href="#projects">View Projects</a>
        <a class="btn btn--ghost" href="#contact">Contact Me</a>
      </div>

      <div class="hero__availability hero-fade">
        <span class="status">Open to remote opportunities and global collaboration</span>
        <span class="meta-label">Sukoharjo, Jawa Tengah, Indonesia</span>
      </div>
    </div>

    <figure class="hero__portrait hero-fade">
      <div class="hero__portrait-frame">
        <img
          src="./portrait-faras.svg"
          width="800"
          height="1000"
          fetchpriority="high"
          alt="Illustrated monochrome portrait of Faras Fadhil Firdaus. The original artwork is being updated to a neutral monochrome treatment."
        />
      </div>
      <figcaption class="meta-label">Faras Fadhil Firdaus, 2026</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(56px, 9vw, 116px) clamp(64px, 9vw, 120px);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: end;
  }
  .hero__copy { max-width: 760px; }
  .hero__headline { margin-block: 24px 28px; }
  .hero-line--quiet { color: var(--subtle); }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }
  .hero__availability {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    margin-top: 40px;
    padding-top: 22px;
    border-top: 1px solid var(--border);
    max-width: 520px;
  }
  .hero__portrait { margin: 0; }
  .hero__portrait-frame {
    background: var(--surface);
    border: 1px solid var(--border);
    aspect-ratio: 4 / 5;
    max-width: 360px;
    margin-inline: auto;
    overflow: hidden;
  }
  .hero__portrait-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.06);
  }
  .hero__portrait figcaption {
    margin-top: 12px;
    text-align: center;
  }

  @media (min-width: 900px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.65fr) minmax(240px, 0.75fr);
      gap: 64px;
    }
    .hero__portrait-frame { margin-inline: 0 0 0 auto; }
    .hero__portrait figcaption { text-align: right; }
  }
  @media (max-width: 899px) {
    .hero__portrait { max-width: 320px; }
  }
  @media (max-width: 420px) {
    .hero__actions .btn { flex: 1 1 100%; }
  }
</style>
