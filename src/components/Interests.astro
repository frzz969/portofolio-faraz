---
// AREAS OF INTEREST - numbered editorial rows di permukaan gelap, bukan
// kartu dashboard. Empat judul ringkas tetap dipakai; detail 9 bidang dari
// src/data/interests.ts dirender sebagai subteks agar tidak ada yang hilang.
import { interests } from '../data/interests';
const areas = [
  'AI & Intelligent Technologies',
  'Language & AI Evaluation',
  'Software & Workflow Automation',
  'Digital Operations & Administration',
];
const detail = interests.areas.join(' · ');
// Data sumber memakai em dash; UI memakai separator "·" (R-02).
const honestyNote = interests.note.replace(/\s*[\u2014\u2013]\s*/g, ' · ');
---

<section class="section section--interests surface-dark" id="interests">
  <div class="container">
    <div class="section-head section-enter section-enter--across">
      <div>
        <span class="eyebrow">Horizons</span>
        <h2 class="h2">Areas of Interest</h2>
      </div>
      <p class="mono section-head__note">Interests and exploration, not professional experience</p>
    </div>

    <ol class="interest-list section-enter section-enter--across" style="--stagger:1">
      {areas.map((area, index) => (
        <li class="interest-row">
          <span class="interest-row__num num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <span class="interest-row__title h3">{area}</span>
          <span class="interest-row__mark" aria-hidden="true"></span>
        </li>
      ))}
    </ol>

    <p class="interest-detail mono">{detail}</p>

    <p class="interest-note mono">
      {honestyNote}
    </p>
  </div>
</section>

<style>
  .interest-list { border-top: 1px solid var(--strong); }
  .interest-detail { margin: 20px 0 0; color: var(--muted); overflow-wrap: anywhere; }
  .interest-row {
    display: grid;
    grid-template-columns: 72px 1fr;
    align-items: center;
    gap: 8px 20px;
    padding-block: 22px;
    border-bottom: 1px solid var(--strong);
  }
  /* Angka besar adalah identitas visual; kontras via var(--muted). */
  .interest-row__num { font-size: clamp(3rem, 6vw, 4.5rem); }
  .interest-row__title { align-self: center; }
  .interest-row__mark {
    display: none;
    width: 24px;
    height: 1px;
    background: var(--white);
    align-self: center;
    justify-self: end;
  }
  .interest-note {
    margin-top: 24px;
    color: var(--muted);
    max-width: 68ch;
  }
  @media (min-width: 700px) {
    .interest-row {
      grid-template-columns: 140px 1fr 32px;
      padding-block: 28px;
    }
    .interest-row__mark { display: block; }
  }
  @media (min-width: 900px) {
    /* Detail catatan sejajar dengan judul, bukan dengan angka: kolom angka
       tetap menjadi margin editorial, daftar tidak berubah menjadi kartu. */
    .interest-detail,
    .interest-note { margin-left: 140px; }
  }
</style>
