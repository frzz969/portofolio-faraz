---
import { interests } from '../data/interests';

// SECTION 8: AREAS OF INTEREST - 9 tag, isi dari src/data/interests.ts.
// Label jujur: minat & arah eksplorasi, bukan pengalaman profesional.
const honestLabel = interests.note.replace(/\s+[\u2014-]\s+/, ', ');
---

<section class="w-full bg-surface-container-low py-20 lg:py-28" id="interests">
  <div class="max-w-[1180px] mx-auto px-margin-mobile lg:px-margin">
    <div class="max-w-2xl mb-12">
      <span class="text-label-sm font-label-sm text-muted-brass uppercase tracking-widest block mb-2 font-mono">07 / HORIZONS</span>
      <h2 class="font-headline-lg text-headline-lg text-ink font-semibold tracking-tight mb-4">Areas of Interest</h2>
      <p class="font-body-lg text-body-lg text-on-surface-variant">
        I'm continuously exploring opportunities and developing my knowledge in:
      </p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-6">
      {interests.areas.map((area) => (
        <div class="card p-5 bg-surface-container rounded-xl shadow-xs flex items-center gap-3">
          <span class="w-2 h-2 shrink-0 interest-mark"></span>
          <span class="font-title-md text-title-md text-ink">{area}</span>
        </div>
      ))}
    </div>
    <div class="p-4 bg-surface-container-high rounded-lg text-body-sm font-body-sm text-on-surface-variant flex items-center gap-2">
      <svg class="text-muted-brass w-[1em] h-[1em] inline-block shrink-0 align-middle" viewBox="0 0 24 24" fill="none" stroke="#3785D8" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7h.01"/></svg>
      <span>{honestLabel}. Clarification note: items above represent active learning interests and proactive personal exploration, bukan pengalaman kerja komersial formal.</span>
    </div>
  </div>
</section>
