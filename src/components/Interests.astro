---
// AREAS OF INTEREST - numbered editorial rows, bukan kartu dashboard.
// Empat judul ringkas tetap dipakai; detail 9 bidang dari src/data/interests.ts
// dirender sebagai subteks agar tidak ada minat yang hilang saat redesign.
import { interests } from '../data/interests';
const areas = [
  'AI & Intelligent Technologies',
  'Language & AI Evaluation',
  'Software & Workflow Automation',
  'Digital Operations & Administration',
];
const detail = interests.areas.join(' · ');
// Data sumber memakai em dash; UI memakai separator "·" sesuai DESIGN.md.
const honestyNote = interests.note.replace(/\s*[—–]\s*/g, ' · ');
---

<section class="section" id="interests">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow">07 / Horizons</span>
        <h2 class="h2">Areas of Interest</h2>
      </div>
      <p class="mono section-head__note">Interests and exploration, not professional experience</p>
    </div>

    <ol class="interest-list">
      {areas.map((area, index) => (
        <li class="interest-row reveal" style={`--stagger:${index}`}>
          <span class="interest-row__num num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <span class="interest-row__title h3">{area}</span>
          <span class="interest-row__mark" aria-hidden="true"></span>
        </li>
      ))}
    </ol>

    <p class="interest-detail mono">{detail}</p>

    <p class="interest-note mono">
      {honestyNote}
    </p>
  </div>
</section>

<style>
  .interest-list { border-top: 1px solid var(--border); }
  .interest-detail { margin: 20px 0 0; color: var(--subtle); overflow-wrap: anywhere; }
  .interest-row {
    display: grid;
    grid-template-columns: 64px 1fr;
    align-items: baseline;
    gap: 8px 20px;
    padding-block: 22px;
    border-bottom: 1px solid var(--border);
  }
  .interest-row__num { font-size: clamp(2rem, 5vw, 3.5rem); }
  .interest-row__title { align-self: center; }
  .interest-row__mark {
    display: none;
    width: 24px;
    height: 1px;
    background: var(--ink);
    align-self: center;
    justify-self: end;
  }
  .interest-note {
    margin-top: 24px;
    color: var(--subtle);
    max-width: 68ch;
  }
  @media (min-width: 700px) {
    .interest-row {
      grid-template-columns: 120px 1fr 32px;
      padding-block: 28px;
    }
    .interest-row__mark { display: block; }
  }
</style>
