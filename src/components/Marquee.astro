---
// SATU marquee monokrom antar section. Separator memakai "·" sesuai DESIGN.md,
// bukan pipe atau em dash (R-02). Diulang dua kali agar loop mulus.
// Pita ini sengaja tidak diberi reveal: ia menjadi jahitan tetap di antara
// section yang masuk satu per satu, supaya alur tidak terbaca sebagai slide.
const words = [
  'AI & Technology',
  'Digital Operations',
  'Creative Development',
  'Continuous Learning',
];
---

<!-- Dekoratif: track aria-hidden, band tidak perlu aria-label. -->
<div class="marquee-band">
  <div class="marquee-track" aria-hidden="true">
    {[0, 1].map(() => (
      <span class="marquee-group">
        {words.map((word) => (
          <span class="marquee-item">{word}<span class="marquee-sep"> · </span></span>
        ))}
      </span>
    ))}
  </div>
</div>

<style>
  .marquee-group { display: inline-flex; }
</style>
