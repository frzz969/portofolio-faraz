---
import { projects } from '../data/projects';

const [dextra, detector, experiments] = projects;

const labelOf = (project: typeof dextra) =>
  (project.liveLabel ?? 'Live demo').replace(/\s*↗\s*$/, '').trim();

// Sumber data memakai em dash; yang dirender memakai separator "·" (R-02).
const clean = (text: string) => text.replace(/\s*[\u2014\u2013]\s*/g, ' · ');

const shot = (name: string) => `${import.meta.env.BASE_URL}/screenshots/${name}`;

// Enam langkah governance yang benar-benar ada di prototipe DEXTRA.
const governanceFlow = [
  {
    name: 'Request',
    detail:
      'A request enters the platform: a task, a question, or an operational action from a defined user.',
  },
  {
    name: 'Analyze',
    detail:
      'Specialized AI workers read the context and supporting data. Four specialists cover Finance, HR, Inventory, and Operations. AI reads and analyzes, nothing is executed here.',
  },
  {
    name: 'Recommend',
    detail:
      'The workers produce a proposed plan. The recommendation ends at advice: no data is written and no outside system is touched.',
  },
  {
    name: 'Approve',
    detail:
      'A human reviews the plan. The Policy Validator, a deterministic governance engine (not an AI agent), checks the plan against policy before approval.',
  },
  {
    name: 'Execute',
    detail:
      'Only after an approved plan and an explicit human mandate may an action change data or the outside world.',
  },
  {
    name: 'Audit',
    detail:
      'Every action leaves an audit record: what was requested, what was approved, what ran, and who mandated it.',
  },
];
---

<section class="section section--work" id="work">
  <div class="container" id="projects">
    <div class="section-head work-head">
      <div class="work-head__title">
        <span class="work-index mono" aria-hidden="true">03</span>
        <span class="eyebrow">Selected Work</span>
        <h2 class="h2 work-head__h2">Built to be examined, not just shown</h2>
      </div>
      <p class="mono section-head__note">Two things I built · one set of notes on what I am still learning</p>
    </div>

    <!-- DEXTRA: feature asimetris. Kiri judul, metadata, inti masalah, dan alur
         governance; kanan screenshot asli dan fakta. Permukaan putih, blok
         gelap hanya pada strip status. -->
    <article class="work-feature reveal" style="--stagger:0">
      <div class="work-feature__left">
        <div class="work-strip">
          <span class="work-strip__label">Featured project 01 · 2026 · Prototype</span>
          <span class="work-strip__status">Interactive prototype</span>
        </div>

        <h3 class="work-feature__title">{dextra.title}</h3>
        <p class="work-feature__subtitle">{clean(dextra.subtitle)}</p>
        <span class="work-rule" aria-hidden="true"></span>

        <div class="work-feature__intro">
          <p class="body work-feature__desc">{clean(dextra.description)}</p>
          <dl class="work-facts work-facts--intro">
            <div>
              <dt>Problem</dt>
              <dd>Operational work spread across tools without clear authority or a traceable record of execution.</dd>
            </div>
            <div>
              <dt>Approach</dt>
              <dd>Specialized AI workers, a deterministic policy check, and human approval before any write action.</dd>
            </div>
          </dl>
        </div>

        <!-- Radio CSS-only. Klik, sentuh, dan arrow keys tetap bekerja;
             panel memakai aria-live="polite" (tidak berubah dari versi awal). -->
        <div class="work-flow">
          <span class="meta-label">Governance path · select a step</span>
          <div class="work-flow__interactive">
            <fieldset class="work-flow__fieldset">
              <legend class="sr-only">Governance steps, use arrow keys to select a step</legend>
              {governanceFlow.map((step, index) => (
                <span class="work-flow__step">
                  <input
                    class="work-flow__input sr-only"
                    type="radio"
                    name="gov-step"
                    id={`gov-step-${index}`}
                    checked={index === 0}
                  />
                  <label class="work-flow__label" for={`gov-step-${index}`}>
                    <span class="work-flow__num num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                    <span class="work-flow__name">{step.name}</span>
                    <span class="work-flow__arrow arrow-glyph" aria-hidden="true">↗</span>
                  </label>
                </span>
              ))}
            </fieldset>

            <div class="work-flow__panels" aria-live="polite">
              {governanceFlow.map((step, index) => (
                <p class="work-flow__panel" data-step={index}>
                  <span class="meta-label">{String(index + 1).padStart(2, '0')} / {step.name}</span>
                  <span class="work-flow__panel-text">{step.detail}</span>
                </p>
              ))}
            </div>
          </div>
          <p class="mono work-flow__note">
            AI acts up to recommendation. Writing to data or the outside world needs an approved plan,
            a human mandate, and an audit record.
          </p>
        </div>
      </div>

      <div class="work-feature__right">
        <figure class="work-shot">
          <div class="work-shot__frame">
            <img
              src={shot('dextra.webp')}
              width="1440"
              height="900"
              loading="lazy"
              alt="Screenshot dashboard DEXTRA asli: Executive Operations Overview dengan metrik workforce, approval queue, dan human authorization."
            />
          </div>
          <figcaption class="meta-label">Captured from the live dashboard · 28 Nov 2026</figcaption>
        </figure>

        <dl class="work-facts work-facts--feature">
          <div>
            <dt>Governance</dt>
            <dd>
              AI reads, analyzes and recommends. Any action that changes data or the outside
              world requires an approved plan and a <strong>human mandate</strong>, then leaves an
              <strong>audit record</strong>. Four specialists: Finance, HR, Inventory, Operations. The
              <strong>Policy Validator</strong> is a deterministic governance engine, not an AI agent.
              This is an interactive prototype, not a production enterprise system.
            </dd>
          </div>
          <div>
            <dt>Stack</dt>
            <dd>Next.js, React, Python, FastAPI, MCP, deterministic policy validation, audit trails.</dd>
          </div>
        </dl>

        <ul class="work-tags">
          <li class="sr-only">Technologies used</li>
          {dextra.focus.map((tag) => <li class="work-tag">{tag}</li>)}
        </ul>

        <div class="work-actions">
          <a class="text-link work-link" href={dextra.caseStudyHref}>
            Explore case study <span class="text-link__arrow arrow-glyph" aria-hidden="true">↗</span>
          </a>
          <a
            class="text-link work-link"
            href={dextra.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${dextra.title}: ${labelOf(dextra)} (opens in new tab)`}
          >
            Live demo <span class="text-link__arrow arrow-glyph" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </article>

    <!-- AI Detector: blok kedua, screenshot penuh, penjelasan jujur. -->
    <article class="work-detector reveal" style="--stagger:1">
      <div class="work-detector__head">
        <span class="eyebrow">Featured project 02 · Live demo</span>
        <h3 class="work-detector__title">{detector.title}</h3>
        <p class="work-detector__subtitle">{clean(detector.subtitle)}</p>
      </div>

      <figure class="work-shot work-shot--wide">
        <div class="work-shot__frame">
          <img
            src={shot('ai-detector.webp')}
            width="1440"
            height="900"
            loading="lazy"
            alt="Screenshot antarmuka AI Detector Mahasiswa asli: editor contoh teks dengan indikator AI 68 persen dan bagian yang ditandai."
          />
        </div>
        <figcaption class="meta-label">Captured from the live demo · 28 Nov 2026</figcaption>
      </figure>

      <div class="work-detector__body">
        <p class="body work-detector__desc">{clean(detector.description)}</p>
        <dl class="work-facts work-facts--detector">
          <div>
            <dt>What it does</dt>
            <dd>
              Reads pasted or uploaded txt, md, pdf and docx files, checks 10 language patterns,
              and shows a score with highlighted text plus a PDF report, in Indonesian and English.
              Text stays private in the browser.
            </dd>
          </div>
          <div>
            <dt>What it does not prove</dt>
            <dd>
              The score is an <strong>uncertain indicator</strong>, <strong>not proof</strong> of AI
              use or an academic-integrity verdict. No detector is 100% accurate, and this is
              <strong>not a replacement for Turnitin</strong>. It is a live prototype, not a
              production service.
            </dd>
          </div>
        </dl>
        <ul class="work-tags">
          <li class="sr-only">Technologies used</li>
          {detector.focus.map((tag) => <li class="work-tag">{tag}</li>)}
        </ul>
        <div class="work-actions">
          <a class="text-link work-link" href={detector.caseStudyHref}>
            Explore case study <span class="text-link__arrow arrow-glyph" aria-hidden="true">↗</span>
          </a>
          <a
            class="text-link work-link"
            href={detector.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${detector.title}: ${labelOf(detector)} (opens in new tab)`}
          >
            Live demo <span class="text-link__arrow arrow-glyph" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </article>

    <!-- Experiments sengaja bukan kartu: catatan pembelajaran, tanpa screenshot. -->
    <div class="work-notes reveal" style="--stagger:2">
      <div class="work-notes__head">
        <span class="eyebrow">Not a finished project · ongoing notes</span>
        <h3 class="h3 work-notes__title">{experiments.title}</h3>
      </div>
      <div class="work-notes__content">
        <p class="body work-notes__desc">{clean(experiments.description)}</p>
        <p class="mono work-notes__note">
          Learning notes and continuous exploration · no public product screenshot · no release date.
        </p>
        <ul class="work-tags">
          <li class="sr-only">Topics</li>
          {experiments.focus.map((tag) => <li class="work-tag">{tag}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  /* Permukaan terang; garis 1px dan whitespace yang membentuk ritme. */
  .section--work {
    background: var(--canvas);
    border-top-color: var(--border);
  }
  .work-head {
    gap: 18px;
    margin-bottom: clamp(32px, 4vw, 56px);
  }
  .work-head__title { min-width: 0; }
  .work-head__h2 { font-size: clamp(2rem, 3.4vw, 3rem); line-height: 1.05; }
  .work-index {
    display: block;
    color: var(--accent);
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    margin-bottom: 8px;
  }
  /* Garis tipis biru 1px di bawah angka section, bukan blok warna. */
  .work-index::after {
    content: "";
    display: block;
    width: 28px;
    height: 1px;
    margin-top: 8px;
    background: var(--accent);
  }
  .work-head__note { color: var(--secondary); }

  /* DEXTRA: white surface, radius konsisten 12px, tanpa shadow. */
  .work-feature {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(28px, 4vw, 56px);
    padding: clamp(20px, 3vw, 40px);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    min-width: 0;
  }
  .work-feature__left,
  .work-feature__right { min-width: 0; }

  .work-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    padding: 10px 14px;
    margin-bottom: clamp(20px, 3vw, 32px);
    background: var(--ink);
    color: var(--white);
    border-radius: 6px;
  }
  .work-strip__label,
  .work-strip__status {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    line-height: 1.5;
  }
  .work-strip__status { color: var(--secondary-surface); }

  .work-feature__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3.5rem, 6.2vw, 5.5rem);
    line-height: 0.92;
    letter-spacing: -0.05em;
    /* Nama pendek: tidak ada pemotongan kata, wrap normal jika perlu. */
    overflow-wrap: normal;
    word-break: keep-all;
    color: var(--ink);
    margin-bottom: 12px;
  }
  .work-feature__subtitle {
    font-family: var(--font-display);
    font-size: clamp(1.0625rem, 1.7vw, 1.375rem);
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--secondary);
    max-width: 36ch;
  }
  .work-rule {
    display: block;
    width: 100%;
    height: 1px;
    margin-block: clamp(24px, 3vw, 36px);
    background: var(--border);
  }
  .work-feature__desc { max-width: 66ch; color: var(--secondary); }

  .work-facts { margin: 0; }
  .work-facts > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 4px 20px;
    padding-block: 14px;
    border-top: 1px solid var(--border);
  }
  .work-facts dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--secondary);
  }
  .work-facts dd {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--ink);
  }
  .work-facts dd strong { font-weight: 700; }
  .work-facts--intro { margin-top: 24px; }

  /* Governance: radio CSS-only, 6 langkah, keyboard + sentuh. */
  .work-flow {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: clamp(24px, 3vw, 36px);
    padding: clamp(16px, 2vw, 24px);
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    min-width: 0;
  }
  .work-flow > .meta-label { color: var(--secondary); }
  .work-flow__interactive {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 18px;
  }
  .work-flow__fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .work-flow__step { display: block; }
  .work-flow__label {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding-block: 10px;
    border-top: 1px solid var(--border);
    cursor: pointer;
    touch-action: manipulation;
  }
  .work-flow__step:first-child .work-flow__label { border-top: 0; }
  .work-flow__num { color: var(--secondary); font-size: 1.5rem; }
  .work-flow__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: -0.02em;
    color: var(--ink);
    transition: transform var(--dur-ui) var(--ease-out);
  }
  .work-flow__arrow { color: var(--secondary); opacity: 0; }

  /* State aktif: garis biru 1px, bukan pill berwarna. */
  .work-flow__input:checked + .work-flow__label .work-flow__num,
  .work-flow__input:checked + .work-flow__label .work-flow__name { color: var(--ink); }
  .work-flow__input:checked + .work-flow__label {
    border-bottom: 1px solid var(--accent);
    padding-inline-start: 6px;
  }
  .work-flow__input:checked + .work-flow__label .work-flow__arrow { opacity: 1; }
  .work-flow__label:active { opacity: 0.74; }
  /* Menimpa aturan global outline putih agar tetap terlihat di permukaan putih. */
  .work-flow .work-flow__input:focus-visible + .work-flow__label {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  @media (hover: hover) and (pointer: fine) {
    .work-flow__label:hover .work-flow__name { transform: translateX(3px); }
    .work-flow__label:hover .work-flow__arrow { opacity: 1; }
  }

  .work-flow__panels { min-width: 0; }
  .work-flow__panel {
    display: none;
    flex-direction: column;
    gap: 6px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--canvas);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--secondary);
  }
  .work-flow__panel-text { color: var(--ink); }

  /* Urutan DOM: fieldset lalu panels, jadi ~ bekerja. */
  .work-flow__fieldset:has(#gov-step-0:checked) ~ .work-flow__panels [data-step="0"],
  .work-flow__fieldset:has(#gov-step-1:checked) ~ .work-flow__panels [data-step="1"],
  .work-flow__fieldset:has(#gov-step-2:checked) ~ .work-flow__panels [data-step="2"],
  .work-flow__fieldset:has(#gov-step-3:checked) ~ .work-flow__panels [data-step="3"],
  .work-flow__fieldset:has(#gov-step-4:checked) ~ .work-flow__panels [data-step="4"],
  .work-flow__fieldset:has(#gov-step-5:checked) ~ .work-flow__panels [data-step="5"] {
    display: flex;
  }
  @supports not selector(:has(*)) {
    .work-flow__panel[data-step="0"] { display: flex; }
  }
  .work-flow__note { color: var(--secondary); max-width: 62ch; }

  /* Screenshot asli: 16/9, zoom sangat halus hanya dengan pointer presisi. */
  .work-shot { margin: 0; min-width: 0; }
  .work-shot__frame {
    aspect-ratio: 16 / 9;
    background: var(--secondary-surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }
  .work-shot__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 220ms var(--ease-out);
  }
  /* Zoom sangat halus hanya pada pointer presisi; tidak di reduced-motion. */
  @media (hover: hover) and (pointer: fine) {
    @media (prefers-reduced-motion: no-preference) {
      .section--work .work-shot__frame:hover img { transform: scale(1.02); }
    }
  }
  .work-shot figcaption {
    padding-top: 10px;
    color: var(--secondary);
  }

  .work-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }
  .work-tag {
    padding: 5px 10px;
    border: 1px solid var(--border);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--secondary);
  }
  .work-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin-top: 24px;
  }
  /* Link: underline biru 1px muncul di hover/fokus, panah bergeser 4px. */
  .work-link { border-bottom-color: var(--border); }
  .section--work .work-link .text-link__arrow {
    transition: transform var(--dur-ui) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .section--work .work-link:hover .text-link__arrow { transform: translate(4px, -4px); }
  }
  .section--work .work-link:focus-visible .text-link__arrow { transform: translate(4px, -4px); }

  /* AI Detector: blok kedua, permukaan putih, screenshot penuh. */
  .work-detector {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(20px, 3vw, 32px);
    padding: clamp(20px, 3vw, 40px);
    margin-top: 24px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    min-width: 0;
  }
  .work-detector__head { min-width: 0; }
  .work-detector__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
    color: var(--ink);
    margin-top: 8px;
    overflow-wrap: normal;
    word-break: keep-all;
  }
  .work-detector__subtitle {
    font-size: 1.0625rem;
    color: var(--secondary);
    margin-top: 6px;
  }
  .work-detector__desc { max-width: 66ch; color: var(--secondary); }
  .work-facts--detector { margin-top: 24px; }

  /* Experiments: teks editorial, bukan kartu identik, tanpa screenshot. */
  .work-notes {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    margin-top: clamp(32px, 4vw, 56px);
    padding-block: clamp(24px, 3vw, 36px);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .work-notes__title { color: var(--ink); margin-top: 8px; }
  .work-notes__content { min-width: 0; }
  .work-notes__desc { max-width: 62ch; color: var(--secondary); }
  .work-notes__note { margin-top: 14px; color: var(--secondary); }

  @media (min-width: 768px) {
    .work-feature__right .work-facts > div,
    .work-facts--detector > div { grid-template-columns: 150px minmax(0, 1fr); }
  }

  @media (min-width: 900px) {
    /* Dua kolom asimetris: kiri narasi + alur, kanan bukti + fakta. */
    .work-feature {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
      gap: clamp(40px, 5vw, 72px);
    }
    .work-flow__interactive { grid-template-columns: minmax(0, 1fr); }
    .work-detector {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      grid-template-areas: 'head shot' 'body shot';
      align-items: start;
      column-gap: clamp(32px, 4vw, 56px);
    }
    .work-detector__head { grid-area: head; }
    .work-detector__body { grid-area: body; }
    .work-shot--wide { grid-area: shot; }
    .work-notes {
      grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
      gap: clamp(24px, 4vw, 56px);
    }
  }

  @media (min-width: 1200px) {
    .work-flow__interactive { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  }

  /* Mobile: satu kolom, gambar proporsional, tidak terpotong sembarangan. */
  @media (max-width: 620px) {
    .work-feature,
    .work-detector { padding: 18px; }
    .work-feature__title { font-size: clamp(3rem, 12vw, 4.5rem); }
    .work-strip { align-items: flex-start; flex-direction: column; }
    .work-shot__frame { aspect-ratio: 4 / 3; }
    .work-shot__frame img { object-fit: contain; }
    .work-tags { gap: 6px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-flow__name,
    .work-link .text-link__arrow,
    .work-shot__frame img { transform: none !important; transition: none !important; }
  }
</style>
