---
import { projects } from '../data/projects';

// SELECTED PROJECTS - asynchronous editorial showcase, DEXTRA sebagai feature utama.
// Screenshot WebP belum tersedia; wrapper memakai path final + alt jujur.
// Tidak menggambar ulang SVG, tidak mengarang fitur atau metrik.
const [dextra, detector, experiments] = projects;

const shots = {
  dextra: {
    src: './screenshots/dextra.webp',
    width: 1200,
    height: 675,
    alt: 'Screenshot antarmuka DEXTRA, platform orkestrasi agen AI untuk operasional. Aset screenshot belum tersedia.',
    caption: 'DEXTRA, primary feature',
  },
  detector: {
    src: './screenshots/ai-detector.webp',
    width: 1200,
    height: 675,
    alt: 'Screenshot antarmuka AI Detector Mahasiswa untuk analisis tulisan akademik Bahasa Indonesia. Aset screenshot belum tersedia.',
    caption: 'AI Detector, live demo',
  },
  experiments: {
    src: './screenshots/experiments.webp',
    width: 1200,
    height: 675,
    alt: 'Screenshot dokumentasi eksperimen teknis AI, MCP, dan integrasi API. Aset screenshot belum tersedia.',
    caption: 'Experiments, ongoing',
  },
};
---

<section class="section" id="work">
  <div class="container" id="projects">
    <div class="section-head">
      <div>
        <span class="eyebrow">03 / Artifacts</span>
        <h2 class="h2">Selected Projects</h2>
      </div>
      <p class="mono section-head__note">System Prototypes / Research Concepts / Lab Experiments</p>
      <span class="sr-only">Anchor for the projects section</span>
    </div>

    <!-- Feature utama: DEXTRA, asimetris (teks kiri, shot kanan). -->
    <article class="project-card project-card--feature reveal">
      <div class="project-card__info">
        <div class="project-card__top">
          <span class="status status--solid">Built</span>
          <span class="meta-label">Enterprise Architecture</span>
        </div>
        <h3 class="h2 project-card__title">{dextra.title}</h3>
        <p class="h4 project-card__subtitle">{dextra.subtitle}</p>
        <p class="body project-card__desc">{dextra.description}</p>

        <dl class="project-facts">
          <div>
            <dt>Problem</dt>
            <dd>Operational work spread across tools without clear authority or a traceable record of execution.</dd>
          </div>
          <div>
            <dt>Contribution</dt>
            <dd>Designed around specialized AI workers, human-defined authority, and approval-based execution.</dd>
          </div>
          <div>
            <dt>Approach</dt>
            <dd>Multi-agent orchestration, MCP integration, deterministic policy validation, and audit trails.</dd>
          </div>
        </dl>

        <div class="tag-list" aria-label="Technologies used">
          {dextra.focus.map((tag) => <span class="tag">{tag}</span>)}
        </div>
        <div class="project-card__links">
          <a class="text-link" href={dextra.liveUrl} target="_blank" rel="noopener noreferrer">
            Live demo <span class="arrow-glyph" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <figure class="project-shot project-shot--feature">
        <div class="project-shot__frame">
          <img
            src={shots.dextra.src}
            width={shots.dextra.width}
            height={shots.dextra.height}
            loading="lazy"
            alt={shots.dextra.alt}
          />
        </div>
        <figcaption class="meta-label">{shots.dextra.caption}</figcaption>
      </figure>
    </article>

    <!-- Dua pendukung: layout tidak simetris penuh, urutan visual berbeda. -->
    <div class="project-pair">
      <article class="project-card project-card--support reveal" style="--stagger:0">
        <div class="project-card__top">
          <span class="status status--solid">Live demo</span>
          <span class="meta-label">Research Lab</span>
        </div>
        <h3 class="h3 project-card__title">{detector.title}</h3>
        <p class="h4 project-card__subtitle">{detector.subtitle}</p>
        <p class="body project-card__desc">{detector.description}</p>

        <figure class="project-shot">
          <div class="project-shot__frame">
            <img
              src={shots.detector.src}
              width={shots.detector.width}
              height={shots.detector.height}
              loading="lazy"
              alt={shots.detector.alt}
            />
          </div>
          <figcaption class="meta-label">{shots.detector.caption}</figcaption>
        </figure>

        <dl class="project-facts project-facts--compact">
          <div>
            <dt>Motivation</dt>
            <dd>Explainable analysis for Indonesian academic writing, not automated penalties.</dd>
          </div>
          <div>
            <dt>Status</dt>
            <dd>Live demo (prototype). No detector is fully accurate, and this is not a replacement for Turnitin.</dd>
          </div>
        </dl>

        <div class="tag-list" aria-label="Technologies used">
          {detector.focus.map((tag) => <span class="tag">{tag}</span>)}
        </div>
        <div class="project-card__links">
          <a class="text-link" href={detector.liveUrl} target="_blank" rel="noopener noreferrer">
            Live demo <span class="arrow-glyph" aria-hidden="true">↗</span>
          </a>
        </div>
      </article>

      <article class="project-card project-card--support project-card--offset reveal" style="--stagger:1">
        <div class="project-card__top">
          <span class="status">Ongoing exploration</span>
          <span class="meta-label">Experimental</span>
        </div>
        <h3 class="h3 project-card__title">{experiments.title}</h3>
        <p class="h4 project-card__subtitle">{experiments.subtitle}</p>

        <figure class="project-shot">
          <div class="project-shot__frame">
            <img
              src={shots.experiments.src}
              width={shots.experiments.width}
              height={shots.experiments.height}
              loading="lazy"
              alt={shots.experiments.alt}
            />
          </div>
          <figcaption class="meta-label">{shots.experiments.caption}</figcaption>
        </figure>

        <p class="body project-card__desc">{experiments.description}</p>

        <dl class="project-facts project-facts--compact">
          <div>
            <dt>Contribution</dt>
            <dd>Independent proofs of concept, documented as learning notes.</dd>
          </div>
          <div>
            <dt>Status</dt>
            <dd>Continuously updated, no fixed release date.</dd>
          </div>
        </dl>

        <div class="tag-list" aria-label="Technologies used">
          {experiments.focus.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .project-card {
    border: 1px solid var(--border);
    background: var(--paper);
    padding: clamp(24px, 4vw, 44px);
  }
  .project-card__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }
  .project-card__title { margin-bottom: 6px; }
  .project-card__subtitle { color: var(--subtle); margin-bottom: 20px; }
  .project-card__desc { max-width: 62ch; }

  .project-facts {
    margin: 28px 0;
    border-top: 1px solid var(--border);
  }
  .project-facts > div {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4px 20px;
    padding-block: 14px;
    border-bottom: 1px solid var(--border);
  }
  .project-facts dt {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--subtle);
  }
  .project-facts dd { font-size: 0.9375rem; line-height: 1.55; color: var(--ink); }
  .project-facts--compact > div { padding-block: 12px; }

  .project-card__links { margin-top: 24px; }

  .project-shot { margin: 24px 0 0; }
  .project-shot__frame {
    background: var(--surface);
    border: 1px solid var(--border);
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }
  .project-shot__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .project-shot figcaption { margin-top: 10px; }

  .project-card--feature {
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
    margin-bottom: 24px;
  }
  .project-pair {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 900px) {
    .project-card--feature {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.82fr);
      align-items: center;
      gap: clamp(40px, 5vw, 72px);
    }
    .project-shot--feature { margin: 0; }
    .project-pair {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      align-items: start;
    }
    /* Asimetri disengaja: kartu kedua turun, bukan grid tiga kartu sama. */
    .project-card--offset { margin-top: 72px; }
    .project-facts > div { grid-template-columns: 120px 1fr; }
  }
</style>
