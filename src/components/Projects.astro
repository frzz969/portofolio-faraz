---
import { projects } from '../data/projects';

// SELECTED PROJECTS - DEXTRA sebagai feature utama. Tidak ada screenshot
// rekaan; preview berupa teks dan alur governance bernomor.
const [dextra, detector, experiments] = projects;

// liveLabel berasal dari data; buang panah dekoratif dari accessible name.
const labelOf = (project: typeof dextra) =>
  (project.liveLabel ?? 'Live demo').replace(/\s*↗\s*$/, '').trim();

// Sumber data memakai em dash; tampilan memakai separator "·" (R-02,
// DESIGN.md). Data tidak diubah, hanya teks yang dirender.
const clean = (text: string) => text.replace(/\s*[—–]\s*/g, ' · ');

// Alur governance DEXTRA: langkah nyata dari deskripsi proyek, bukan fitur rekaan.
const governanceFlow = ['Request', 'Analyze', 'Recommend', 'Approve', 'Execute', 'Audit'];

---

<section class="section" id="work">
  <div class="container" id="projects">
    <div class="section-head">
      <div>
        <span class="eyebrow">03 / Artifacts</span>
        <h2 class="h2">Selected Projects</h2>
      </div>
      <p class="mono section-head__note">System Prototypes / Research Concepts / Lab Experiments</p>
      <span class="sr-only">Anchor for the projects section</span>
    </div>

    <!-- Feature utama: DEXTRA, asimetris (teks kiri, alur governance kanan). -->
    <article class="project-card project-card--feature reveal">
      <div class="project-card__info">
        <div class="project-card__top">
          <span class="status status--solid">Built</span>
          <span class="meta-label">Enterprise Architecture</span>
        </div>
        <h3 class="h2 project-card__title">{dextra.title}</h3>
        <p class="h4 project-card__subtitle">{dextra.subtitle}</p>
        <p class="body project-card__desc">{clean(dextra.description)}</p>
        <p class="mono project-preview-note">No authentic product screenshot yet. This preview is text only.</p>

        <dl class="project-facts">
          <div>
            <dt>Problem</dt>
            <dd>Operational work spread across tools without clear authority or a traceable record of execution.</dd>
          </div>
          <div>
            <dt>Contribution</dt>
            <dd>Designed around specialized AI workers, human-defined authority, and approval-based execution.</dd>
          </div>
          <div>
            <dt>Governance</dt>
            <dd>AI reads, analyzes and recommends. Any action that changes data or the outside world requires an approved plan, a human mandate, and an audit record. Four specialists: Finance, HR, Inventory, Operations. The Policy Validator is a deterministic governance engine, not an AI agent.</dd>
          </div>
          <div>
            <dt>Approach</dt>
            <dd>Multi-agent orchestration, MCP integration, deterministic policy validation, and audit trails. Interactive prototype, not a production enterprise deployment.</dd>
          </div>
        </dl>

        <ul class="tag-list">
          <li class="sr-only">Technologies used</li>
          {dextra.focus.map((tag) => <li class="tag">{tag}</li>)}
        </ul>
        <div class="project-card__links">
          <a
            class="text-link"
            href={dextra.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${dextra.title}: ${labelOf(dextra)} (opens in new tab)`}
          >
            Live demo <span class="text-link__arrow arrow-glyph" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <!-- Signature visual DEXTRA: alur governance sebagai baris editorial
           bernomor. Monokrom, tanpa screenshot rekaan atau mockup dashboard.
           Angka 01-06 adalah urutan langkah, bukan metrik. -->
      <div class="project-flow">
        <span class="meta-label">Governance path</span>
        <ol class="project-flow__steps">
          {governanceFlow.map((step, index) => (
            <li class="project-flow__step">
              <span class="project-flow__num num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <span class="project-flow__name">{step}</span>
            </li>
          ))}
        </ol>
        <p class="mono project-flow__note">
          AI acts up to recommendation. Writing to data or the outside world needs an approved plan, a human mandate, and an audit record.
        </p>
      </div>
    </article>

    <!-- Dua pendukung: layout tidak simetris penuh, urutan visual berbeda. -->
    <div class="project-pair">
      <article class="project-card project-card--support reveal" style="--stagger:0">
        <div class="project-card__top">
          <span class="status status--solid">Live demo</span>
          <span class="meta-label">Research Lab</span>
        </div>
        <h3 class="h3 project-card__title">{detector.title}</h3>
        <p class="h4 project-card__subtitle">{detector.subtitle}</p>
        <p class="body project-card__desc">{clean(detector.description)}</p>
        <p class="mono project-preview-note">No authentic product screenshot yet. This preview is text only.</p>


        <dl class="project-facts project-facts--compact">
          <div>
            <dt>Motivation</dt>
            <dd>Explainable analysis for Indonesian academic writing, not automated penalties.</dd>
          </div>
          <div>
            <dt>Status</dt>
            <dd>Live demo (prototype). It reads pasted or uploaded txt, md, pdf and docx files, checks 10 language patterns, and shows a score with highlighted text plus a PDF report. The score is an uncertain indicator, not proof of AI use or an academic-integrity verdict. No detector is 100% accurate, and this is not a replacement for Turnitin.</dd>
          </div>
        </dl>

        <ul class="tag-list">
          <li class="sr-only">Technologies used</li>
          {detector.focus.map((tag) => <li class="tag">{tag}</li>)}
        </ul>
        <div class="project-card__links">
          <a
            class="text-link"
            href={detector.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${detector.title}: ${labelOf(detector)} (opens in new tab)`}
          >
            Live demo <span class="text-link__arrow arrow-glyph" aria-hidden="true">↗</span>
          </a>
        </div>
      </article>

      <article class="project-card project-card--support project-card--offset reveal" style="--stagger:1">
        <div class="project-card__top">
          <span class="status">Ongoing exploration</span>
          <span class="meta-label">Experimental</span>
        </div>
        <h3 class="h3 project-card__title">{experiments.title}</h3>
        <p class="h4 project-card__subtitle">{experiments.subtitle}</p>


        <p class="body project-card__desc">{clean(experiments.description)}</p>
        <p class="mono project-preview-note">No public product screenshot. Documented as learning notes.</p>

        <dl class="project-facts project-facts--compact">
          <div>
            <dt>Contribution</dt>
            <dd>Independent proofs of concept, documented as learning notes.</dd>
          </div>
          <div>
            <dt>Status</dt>
            <dd>Continuously updated, no fixed release date.</dd>
          </div>
        </dl>

        <ul class="tag-list">
          <li class="sr-only">Technologies used</li>
          {experiments.focus.map((tag) => <li class="tag">{tag}</li>)}
        </ul>
      </article>
    </div>
  </div>
</section>

<style>
  .project-card {
    border: 1px solid var(--border);
    background: var(--paper);
    padding: clamp(24px, 4vw, 44px);
  }
  .project-card__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }
  /* Projects dan Contact diberi tekanan hierarki lebih besar dari section
     lain. Garis, eyebrow, dan note tetap dipertahankan, layout tidak dirombak. */
  .section-head > div > .h2 { font-size: clamp(2.125rem, 5.2vw, 3.375rem); }

  .project-card__title { margin-bottom: 6px; }
  .project-card__subtitle { color: var(--subtle); margin-bottom: 20px; }
  .project-card__desc { max-width: 62ch; }

  .project-flow {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 24px;
    border: 1px solid var(--border);
    background: var(--surface);
  }
  .project-flow__steps {
    display: flex;
    flex-direction: column;
    margin: 0;
  }
  .project-flow__step {
    display: grid;
    grid-template-columns: 44px 1fr;
    align-items: baseline;
    gap: 12px;
    padding-block: 10px;
    border-top: 1px solid var(--border);
  }
  .project-flow__step:first-child { border-top: 0; }
  /* Angka urutan dibaca sebagai struktur, bukan dekorasi: pakai tinta,
     bukan --border yang nyaris tak terlihat di atas surface. */
  .project-flow__num { font-size: 1.5rem; color: var(--ink); }
  .project-flow__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: -0.015em;
    color: var(--ink);
  }
  .project-flow__note { color: var(--subtle); }

  .project-facts {
    margin: 28px 0;
    border-top: 1px solid var(--border);
  }
  .project-facts > div {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4px 20px;
    padding-block: 14px;
    border-bottom: 1px solid var(--border);
  }
  .project-facts dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--subtle);
  }
  .project-facts dd { font-size: 0.9375rem; line-height: 1.55; color: var(--ink); }
  .project-facts--compact > div { padding-block: 12px; }

  .project-card__links { margin-top: 24px; }

  .project-card--feature {
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
    margin-bottom: 24px;
  }
  .project-pair {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 900px) {
    .project-card--feature {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.82fr);
      align-items: center;
      gap: clamp(40px, 5vw, 72px);
    }
    .project-pair {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      align-items: start;
    }
    /* Asimetri disengaja: kartu kedua turun, bukan grid tiga kartu sama. */
    .project-card--offset { margin-top: 72px; }
    .project-facts > div { grid-template-columns: 120px 1fr; }
  }
</style>
