---
import { skillGroups } from '../data/skills';

// SKILLS - grouped lists. Tidak ada progress bar atau persentase.
const introductions = [
  'Models, assisted execution, and evaluation workflows.',
  'Runtimes, frameworks, and deterministic APIs.',
  'Infrastructure, wiring, and diagnostics.',
  'Structured administration and reporting.',
];
---

<section class="section" id="skills">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow">06 / Toolkit</span>
        <h2 class="h2">Skills &amp; Technologies</h2>
      </div>
      <p class="mono section-head__note">Organized by discipline. No subjective percentage bars.</p>
    </div>

    <div class="skills__grid">
      {skillGroups.map((group, index) => (
        <section class="skills__group reveal" style={`--stagger:${index}`} aria-labelledby={`skill-${index}`}>
          <span class="num skills__num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <h3 class="h3" id={`skill-${index}`}>{group.name}</h3>
          <p class="body skills__desc">{introductions[index]}</p>
          <ul class="skills__list">
            {group.items.map((item) => (
              <li class="mono">{item}</li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</section>

<style>
  .skills__grid {
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--border);
  }
  .skills__group {
    position: relative;
    padding: 28px 0 32px;
    border-bottom: 1px solid var(--border);
  }
  .skills__num {
    position: absolute;
    top: 24px;
    right: 0;
    font-size: 2.25rem;
  }
  .skills__desc { margin-top: 10px; max-width: 34ch; }
  .skills__list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin-top: 20px;
    max-width: 48ch;
  }
  .skills__list li {
    color: var(--ink);
    border-bottom: 1px solid var(--border);
  }

  @media (min-width: 640px) {
    .skills__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 40px;
    }
  }
  @media (min-width: 1024px) {
    .skills__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: 28px;
    }
  }
</style>
