---
import { skillGroups } from '../data/skills';

// SECTION 7: SKILLS & TECHNOLOGIES - tag chips, isi dari src/data/skills.ts.
const descriptions = [
  'Cognitive architectures and assisted execution suites.',
  'Web runtimes, frameworks, and deterministic APIs.',
  'Foundational infrastructure, wiring, and diagnostics.',
  'Structured administration and organizational reporting.',
];

const icons = [
  '<rect x="4" y="8" width="16" height="12" rx="3"/><path d="M12 4v4M8 14h.01M16 14h.01M9 17h6"/>',
  '<path d="M9 7l-5 5 5 5M15 7l5 5-5 5"/>',
  '<rect x="9" y="2" width="6" height="6" rx="1"/><rect x="2" y="16" width="6" height="6" rx="1"/><rect x="16" y="16" width="6" height="6" rx="1"/><path d="M12 8v4M5 16v-2h14v2"/>',
  '<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 3h6v3H9zM9 11h6M9 15h6"/>',
];
---

<section class="w-full py-20 lg:py-28" id="skills">
  <div class="max-w-[1180px] mx-auto px-margin-mobile lg:px-margin">
    <div class="flex flex-col md:flex-row md:items-baseline justify-between mb-14 gap-4">
      <div>
        <span class="text-label-sm font-label-sm text-muted-brass uppercase tracking-widest block mb-2 font-mono">06 / TOOLKIT</span>
        <h2 class="font-headline-lg text-headline-lg text-ink font-semibold tracking-tight">Skills &amp; Technologies</h2>
      </div>
      <p class="text-body-sm font-body-sm text-on-surface-variant max-w-xs md:text-right font-mono">
        Organized by discipline. No subjective percentage bars.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {skillGroups.map((group, index) => (
        <div class="card bg-surface-container p-6 rounded-xl shadow-sm flex flex-col">
          <div class="flex items-center gap-2 mb-4 text-accent-oxblood quiet-accent">
            <svg class="w-[1em] h-[1em] inline-block shrink-0 align-middle" viewBox="0 0 24 24" fill="none" stroke="#8C2F39" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[index]} />
            <h3 class="font-title-md text-title-md font-semibold text-ink">{group.name}</h3>
          </div>
          <p class="text-body-sm font-body-sm text-on-surface-variant mb-6">{descriptions[index]}</p>
          <div class="flex flex-wrap gap-2 mt-auto">
            {group.items.map((item) => (
              <span class="px-2.5 py-1 rounded-md bg-surface-container-high text-ink text-label-sm font-label-sm">{item}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
