---
// HOW I WORK - dulu "What I Do" berbentuk 4 bento cards. Kini disusun sebagai
// pernyataan editorial pendek. Empat bidang detail ada di Interests (numbered
// rows), jadi tidak ada pengulangan dan tidak ada bento grid.
const notes = [
  'Harnessing foundational models, prompt engineering, agentic patterns, and AI-assisted workflows to structure unstructured information.',
  'Exploring Indonesian computational linguistics, dataset quality verification, and analytical text evaluation.',
  'Building modular interfaces, REST services, and autonomous scripting with modern web stacks and LLM endpoints.',
  'Systematic record curation, spreadsheet modeling, and document workflow optimization.',
];
---

<section class="section" id="approach">
  <div class="container">
    <div class="approach__grid">
      <div class="section-head">
        <div>
          <span class="eyebrow">02 / Approach</span>
          <h2 class="h2">How I Work</h2>
        </div>
      </div>

      <div class="approach__body">
        <p class="lead reveal">
          A blend of practical infrastructure capabilities and exploratory technological
          frontiers. I start from the fundamentals, then use the right tools to move faster.
        </p>
        <ul class="approach__list">
          {notes.map((note, index) => (
            <li class="approach__item reveal" style={`--stagger:${index}`}>
              <span class="approach__index mono">{String(index + 1).padStart(2, '0')}</span>
              <span>{note}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .approach__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }
  .approach__body { max-width: 68ch; }
  .approach__list {
    margin-top: 32px;
    border-top: 1px solid var(--border);
  }
  .approach__item {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 16px;
    padding-block: 18px;
    border-bottom: 1px solid var(--border);
    color: var(--subtle);
    line-height: 1.6;
  }
  .approach__index { padding-top: 4px; color: var(--ink); }
  @media (min-width: 900px) {
    .approach__grid {
      grid-template-columns: minmax(240px, 0.7fr) minmax(0, 1.3fr);
      gap: clamp(40px, 6vw, 88px);
    }
    .approach__item { grid-template-columns: 56px 1fr; }
  }
</style>
