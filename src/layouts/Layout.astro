---
import '../styles/global.css';
import '../styles/motion.css';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Faras Fadhil Firdaus - Technology Enthusiast & AI-Assisted Developer',
  description = 'Building DEXTRA, bringing the AI Detector for students to life, and running ongoing AI experiments.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://frzz969.github.io').href;

const person = {
  '@type': 'Person',
  '@id': `${canonical}#person`,
  name: 'Faras Fadhil Firdaus',
  description:
    'Building DEXTRA, bringing the AI Detector for students to life, and running ongoing AI experiments.',
  jobTitle: 'Technology Enthusiast & AI-assisted Developer',
  url: canonical,
  sameAs: ['https://github.com/farasfadhil', 'https://linkedin.com/in/faras-fadhil-firdaus'],
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      '@id': `${canonical}#profilepage`,
      url: canonical,
      name: title,
      description,
      mainEntity: { '@id': `${canonical}#person` },
    },
    person,
  ],
};

// Nav: hanya section yang benar-benar ada di halaman.
const navItems = [
  { id: 'about', label: 'About' },
  { id: 'projects', label: 'Projects' },
  { id: 'experience', label: 'Experience' },
  { id: 'contact', label: 'Contact' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F7F7F7" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="id" href={canonical} />
    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="./favicon.svg" />
    <link rel="preload" as="font" type="font/woff2" href="./fonts/space-grotesk-latin.woff2" crossorigin />
    <link rel="expect" href="#main" blocking="render" />
    <!-- Motion hanya diaktifkan kalau JS benar-benar jalan. Teks default terlihat. -->
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('has-motion');
      }
    </script>

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Faras Fadhil Firdaus" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://frzz969.github.io/portofolio-faraz/og-image.svg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Faras Fadhil Firdaus, technology enthusiast dan AI-assisted developer." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://frzz969.github.io/portofolio-faraz/og-image.svg" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <header class="site-header" id="siteHeader">
      <div class="container site-header__inner">
        <a class="wordmark" href="#hero" aria-label="Faras Fadhil Firdaus, back to top">
          <span class="wordmark__mono">FFF</span>
          <span class="wordmark__name">Faras Fadhil Firdaus</span>
        </a>

        <nav class="site-nav" aria-label="Main navigation">
          {navItems.map((item) => (
            <a class="site-nav__link" href={`#${item.id}`} data-nav={item.id}>{item.label}</a>
          ))}
        </nav>

        <div class="site-header__end">
          <span class="availability" aria-label="Available for opportunities">
            <span class="availability__dot" aria-hidden="true"></span>
            <span>Available</span>
          </span>
          <details class="mobile-nav" aria-label="Mobile navigation">
            <summary aria-label="Open navigation menu">Menu</summary>
            <nav aria-label="Mobile sections">
              <a href="#about">About</a>
              <a href="#projects">Projects</a>
              <a href="#experience">Experience</a>
              <a href="#education">Education</a>
              <a href="#skills">Skills</a>
              <a href="#interests">Interests</a>
              <a href="#contact">Contact</a>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script is:inline>
      (() => {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Reveal sekali, lalu berhenti mengamati elemen tersebut.
        const revealables = document.querySelectorAll('.reveal');
        if (!reduce && 'IntersectionObserver' in window && revealables.length) {
          const revealObserver = new IntersectionObserver((entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                obs.unobserve(entry.target);
              }
            });
          }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
          revealables.forEach((el) => revealObserver.observe(el));
          // Safety net: kalau observer gagal fire di WebView/HP tertentu,
          // teks tetap tampil. Animasi normal sudah selesai sebelum ini.
          window.setTimeout(() => {
            revealables.forEach((el) => el.classList.add('is-visible'));
          }, 1200);
        } else {
          revealables.forEach((el) => el.classList.add('is-visible'));
        }

        // Active nav mengikuti section yang sedang dibaca.
        const links = Array.from(document.querySelectorAll('[data-nav]));
        const targets = links
          .map((link) => document.getElementById(link.dataset.nav))
          .filter(Boolean);
        if ('IntersectionObserver' in window && targets.length) {
          const navObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              links.forEach((link) => {
                const active = link.dataset.nav === entry.target.id;
                link.classList.toggle('is-active', active);
                if (active) link.setAttribute('aria-current', 'true');
                else link.removeAttribute('aria-current');
              });
            });
          }, { rootMargin: '-30% 0px -60% 0px', threshold: 0 });
          targets.forEach((target) => navObserver.observe(target));
        }

        // Tutup menu mobile setelah memilih tautan.
        const menu = document.querySelector('.mobile-nav');
        menu?.querySelectorAll('a').forEach((a) => {
          a.addEventListener('click', () => { menu.open = false; });
        });
        document.addEventListener('click', (event) => {
          if (menu?.open && !menu.contains(event.target)) menu.open = false;
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && menu?.open) {
            menu.open = false;
            menu.querySelector('summary')?.focus();
          }
        });

        // Sticky header: garis bawah muncul setelah halaman digulir.
        const header = document.getElementById('siteHeader');
        const onScroll = () => {
          header?.classList.toggle('is-scrolled', window.scrollY > 8);
        };
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      })();
    </script>

    <style is:global>
      /* --- Header sticky minimal ------------------------------------------ */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        width: 100%;
        background: var(--paper);
        border-bottom: 1px solid transparent;
        transition: border-color var(--dur-ui) var(--ease-ui),
                    background-color var(--dur-ui) var(--ease-ui);
      }
      .site-header.is-scrolled { border-bottom-color: var(--border); }
      .site-header__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        min-height: var(--header-h);
      }
      .wordmark {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        min-height: 44px;
        flex-shrink: 0;
      }
      .wordmark__mono {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1rem;
        letter-spacing: -0.04em;
        color: var(--white);
        background: var(--ink);
        padding: 4px 6px;
      }
      .wordmark__name {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 0.875rem;
        letter-spacing: -0.015em;
        color: var(--ink);
      }
      .site-nav { display: none; align-items: center; gap: 4px; }
      .site-nav__link {
        position: relative;
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        padding-inline: 14px;
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--subtle);
        transition: color var(--dur-ui) var(--ease-ui);
      }
      .site-nav__link::after {
        content: "";
        position: absolute;
        left: 14px;
        right: 14px;
        bottom: 10px;
        height: 1px;
        background: var(--ink);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform var(--dur-ui) var(--ease-ui);
      }
      .site-nav__link:hover,
      .site-nav__link.is-active { color: var(--ink); }
      .site-nav__link.is-active::after { transform: scaleX(1); }

      .site-header__end { display: inline-flex; align-items: center; gap: 12px; }
      .availability {
        display: none;
        align-items: center;
        gap: 8px;
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.04em;
        color: var(--subtle);
      }
      .availability__dot {
        width: 6px;
        height: 6px;
        background: var(--ink);
        border-radius: 50%;
      }
      @media (min-width: 768px) { .availability { display: inline-flex; } }
      @media (min-width: 900px) {
        .site-nav { display: inline-flex; }
        .mobile-nav { display: none; }
      }

      /* Menu mobile: label terlihat, bukan hamburger tanpa nama. */
      .mobile-nav { position: relative; }
      .mobile-nav > summary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding-inline: 14px;
        border: 1px solid var(--border);
        list-style: none;
        font-size: 0.8125rem;
        font-weight: 600;
        color: var(--ink);
      }
      .mobile-nav > summary::-webkit-details-marker { display: none; }
      .mobile-nav[open] > summary { background: var(--surface); }
      .mobile-nav nav {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        width: min(260px, calc(100vw - 40px));
        display: flex;
        flex-direction: column;
        padding: 6px;
        background: var(--paper);
        border: 1px solid var(--border);
      }
      .mobile-nav nav a {
        display: flex;
        align-items: center;
        min-height: 44px;
        padding-inline: 12px;
        font-size: 0.875rem;
        color: var(--ink);
      }
      .mobile-nav nav a:hover { background: var(--surface); }

      main { display: block; }
    </style>
  </body>
</html>
