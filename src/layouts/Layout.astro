---
import '../styles/global.css';
import '../styles/motion.css';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = 'Faras Fadhil Firdaus - Technology Enthusiast & AI-Assisted Developer',
  description = 'Building DEXTRA, bringing the AI Detector for students to life, and running ongoing AI experiments.',
  canonical: canonicalOverride,
} = Astro.props;

const site = Astro.site ?? new URL('https://frzz969.github.io');
// Astro.url.pathname sudah menyertakan base /portofolio-faraz, jadi hasilnya
// https://frzz969.github.io/portofolio-faraz/ (trailing slash konsisten).
const canonical = canonicalOverride ?? new URL(Astro.url.pathname, site).href;

const person = {
  '@type': 'Person',
  '@id': `${canonical}#person`,
  name: 'Faras Fadhil Firdaus',
  description:
    'Building DEXTRA, bringing the AI Detector for students to life, and running ongoing AI experiments.',
  jobTitle: 'Technology Enthusiast & AI-assisted Developer',
  url: canonical,
  sameAs: ['https://github.com/farasfadhil', 'https://linkedin.com/in/faras-fadhil-firdaus'],
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      '@id': `${canonical}#profilepage`,
      url: canonical,
      name: title,
      description,
      mainEntity: { '@id': `${canonical}#person` },
    },
    person,
  ],
};

// Nav: hanya section yang benar-benar ada di halaman.
const navItems = [
  { id: 'about', label: 'About' },
  { id: 'projects', label: 'Projects' },
  { id: 'experience', label: 'Experience' },
  { id: 'contact', label: 'Contact' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F3F7FA" />
    <link rel="canonical" href={canonical} />
    <!-- Hanya satu versi halaman yang benar-benar ada (bahasa Inggris).
         hreflang id dihapus: tidak ada halaman /id/ palsu yang bisa ditunjuk. -->
    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="./favicon.svg" />
    <!-- Tiga face aktif: display Syne, body Plus Jakarta Sans, mono JetBrains Mono. -->
    <link rel="preload" as="font" type="font/woff2" href="./fonts/syne-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="./fonts/plus-jakarta-sans-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="./fonts/jetbrains-mono-latin.woff2" crossorigin />
    <!-- Hint render-blocking untuk #main sengaja tidak dipakai: menunggu
         konten utama menunda first paint tanpa manfaat di halaman ini. -->
    <!-- Motion hanya diaktifkan kalau JS benar-benar jalan. Teks default terlihat. -->
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('has-motion');
      }
    </script>

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Faras Fadhil Firdaus" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://frzz969.github.io/portofolio-faraz/og-image.svg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Faras Fadhil Firdaus, technology enthusiast dan AI-assisted developer." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://frzz969.github.io/portofolio-faraz/og-image.svg" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="reading-progress" aria-hidden="true"></div>

    <header class="site-header" id="siteHeader">
      <div class="container site-header__inner">
        <a class="wordmark" href="#hero" aria-label="Faras Fadhil Firdaus, back to top">
          <span class="wordmark__mono">FFF</span>
          <span class="wordmark__name">Faras Fadhil Firdaus</span>
        </a>

        <nav class="site-nav" aria-label="Main navigation">
          {navItems.map((item) => (
            <a class="site-nav__link" href={`#${item.id}`} data-nav={item.id} data-magnetic>{item.label}</a>
          ))}
        </nav>

        <div class="site-header__end">
          <span class="availability">
            <span class="availability__dot" aria-hidden="true"></span>
            <span>Open to opportunities</span>
          </span>
          <details class="mobile-nav">
            <summary><span class="mobile-nav__state">Open</span> menu</summary>
            <nav aria-label="Mobile sections">
              <a href="#about">About</a>
              <a href="#projects">Projects</a>
              <a href="#experience">Experience</a>
              <a href="#education">Education</a>
              <a href="#skills">Skills</a>
              <a href="#interests">Interests</a>
              <a href="#contact">Contact</a>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <Footer />

    <!-- Back-to-top: tombol kecil di pojok kanan bawah, muncul setelah hero.
         Footer/CTA memang sudah punya tautan "Back to top"; tombol ini hanya
         jalan pintas saat membaca, dan disembunyikan saat CTA/footer terlihat
         supaya tidak menimpa keduanya (R-31). -->
    <button class="back-to-top" id="backToTop" type="button" aria-label="Back to top" title="Back to top">
      <span class="back-to-top__arrow" aria-hidden="true"></span>
    </button>

    <script is:inline>
      (() => {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Reveal sekali, lalu berhenti mengamati elemen tersebut.
        const revealables = Array.from(document.querySelectorAll('.reveal'));
        const markReached = (el) => {
          el.classList.add('is-visible');
          el.querySelectorAll('.timeline__item').forEach((item) => {
            item.classList.add('is-reached');
          });
        };

        // Progres timeline mengikuti item, bukan seluruh section sekaligus.
        const timelineItems = Array.from(document.querySelectorAll('.timeline__item'));
        if (!reduce && 'IntersectionObserver' in window && timelineItems.length) {
          const itemObserver = new IntersectionObserver((entries, obs) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-reached');
              obs.unobserve(entry.target);
            });
          }, { rootMargin: '0px 0px -20% 0px', threshold: 0.25 });
          timelineItems.forEach((item) => itemObserver.observe(item));
          window.setTimeout(() => {
            timelineItems.forEach((item) => {
              const box = item.getBoundingClientRect();
              if (box.top < window.innerHeight && box.bottom > 0) {
                item.classList.add('is-reached');
                itemObserver.unobserve(item);
              }
            });
          }, 1200);
        } else {
          timelineItems.forEach((item) => item.classList.add('is-reached'));
        }

        if (!reduce && 'IntersectionObserver' in window && revealables.length) {
          const revealObserver = new IntersectionObserver((entries, obs) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              markReached(entry.target);
              obs.unobserve(entry.target);
            });
          }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
          revealables.forEach((el) => revealObserver.observe(el));
          // Dua level safety: yang sudah masuk viewport menyala lebih awal agar
          // reveal tetap terasa; sisanya menyala sebelum batas akhir demi
          // progressive enhancement. Urutan observer didahulukan, jadi elemen
          // yang terlihat lebih dulu tetap mendapat animasi normal.
          window.setTimeout(() => {
            revealables.forEach((el) => {
              if (el.classList.contains('is-visible')) return;
              const box = el.getBoundingClientRect();
              if (box.top < window.innerHeight && box.bottom > 0) {
                markReached(el);
                revealObserver.unobserve(el);
              }
            });
          }, 1200);
          window.setTimeout(() => {
            revealables.forEach((el) => {
              if (el.classList.contains('is-visible')) return;
              markReached(el);
              revealObserver.unobserve(el);
            });
          }, 2500);
        } else {
          revealables.forEach(markReached);
        }

        // Baris CTA bukan hero: muncul saat section contact terlihat, bukan
        // saat halaman dimuat (dulu memakai .hero-line sehingga animasinya
        // berjalan di atas fold dan selesai sebelum CTA dibaca).
        const ctaSection = document.querySelector('.contact');
        const ctaLines = Array.from(document.querySelectorAll('.contact .cta-line'));
        if (!reduce && 'IntersectionObserver' in window && ctaSection && ctaLines.length) {
          const ctaObserver = new IntersectionObserver((entries, obs) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              ctaSection.classList.add('is-reached');
              obs.unobserve(entry.target);
            });
          }, { rootMargin: '0px 0px -12% 0px', threshold: 0.15 });
          ctaObserver.observe(ctaSection);
          window.setTimeout(() => {
            const box = ctaSection.getBoundingClientRect();
            if (box.top < window.innerHeight && box.bottom > 0) {
              ctaSection.classList.add('is-reached');
              ctaObserver.unobserve(ctaSection);
            }
          }, 1200);
        } else {
          ctaSection?.classList.add('is-reached');
        }

        // Active nav: pilih section terdekat garis band, bukan entry terakhir
        // yang kebetulan dipublish observer saat scroll naik.
        const links = Array.from(document.querySelectorAll('[data-nav]'));
        const targets = links
          .map((link) => document.getElementById(link.dataset.nav))
          .filter(Boolean);
        const setActiveNav = () => {
          const band = window.innerHeight * 0.3;
          let closest = null;
          let smallest = Infinity;
          targets.forEach((target) => {
            const box = target.getBoundingClientRect();
            const within = box.top <= band && box.bottom >= band;
            const gap = within ? 0 : Math.min(
              Math.abs(box.top - band),
              Math.abs(box.bottom - band)
            );
            if (gap < smallest) {
              smallest = gap;
              closest = target;
            }
          });
          // FLIP marker (technique from hexagoncircle/scrollspy-nav, MIT):
          // satu hairline biru meluncur ke link aktif, bukan underline statis.
          const navList = document.querySelector('.site-nav');
          let marker = navList?.querySelector('.site-nav__marker');
          if (navList && !marker) {
            marker = document.createElement('span');
            marker.className = 'site-nav__marker';
            marker.setAttribute('aria-hidden', 'true');
            navList.appendChild(marker);
          }
          let previous = links.find((link) => link.classList.contains('is-active'));
          links.forEach((link) => {
            const active = !!closest && link.dataset.nav === closest.id;
            link.classList.toggle('is-active', active);
            if (active) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          });
          const current = links.find((link) => link.classList.contains('is-active'));
          if (marker && current) {
            const first = previous?.getBoundingClientRect();
            const last = current.getBoundingClientRect();
            const deltaX = first ? first.left - last.left : 0;
            const canMotion = document.documentElement.classList.contains('has-motion')
              && !window.matchMedia('(prefers-reduced-motion: reduce)').matches
              && typeof marker.animate === 'function';
            marker.style.left = `${last.left - navList.getBoundingClientRect().left}px`;
            marker.style.width = `${last.width}px`;
            if (canMotion && deltaX !== 0) {
              marker.animate(
                [
                  { transform: `translateX(${deltaX}px) scaleX(${first.width / Math.max(last.width, 1)})` },
                  { transform: 'translateX(0) scaleX(1)' },
                ],
                { duration: 220, easing: 'cubic-bezier(0.25, 1, 0.5, 1)', fill: 'none' }
              );
            }
            previous = current;
          }
        };
        if (targets.length) {
          setActiveNav();
          window.addEventListener('scroll', setActiveNav, { passive: true });
          window.addEventListener('resize', setActiveNav, { passive: true });
        }

        // Tutup menu mobile setelah memilih tautan; label summary mengikuti state.
        const menu = document.querySelector('.mobile-nav');
        const menuState = menu?.querySelector('.mobile-nav__state');
        const syncMenuLabel = () => {
          if (menuState) menuState.textContent = menu?.open ? 'Close' : 'Open';
        };
        menu?.addEventListener('toggle', syncMenuLabel);
        syncMenuLabel();
        menu?.querySelectorAll('a').forEach((a) => {
          a.addEventListener('click', () => { menu.open = false; });
        });
        document.addEventListener('click', (event) => {
          if (menu?.open && !menu.contains(event.target)) menu.open = false;
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && menu?.open) {
            menu.open = false;
            menu.querySelector('summary')?.focus();
          }
        });

        // Header: siap dipakai segera setelah script ini jalan, lalu berubah
        // compact setelah scroll 8px. is-ready bukan loading overlay; tanpa JS
        // header tetap terlihat karena opacity default ada di CSS.
        const header = document.getElementById('siteHeader');
        header?.classList.add('is-ready');
        const onScroll = () => {
          const scrolled = window.scrollY > 8;
          header?.classList.toggle('is-scrolled', scrolled);
          header?.classList.toggle('is-compact', scrolled);
        };
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });

        // Portrait: maks 6px, hanya mouse presisi dan tanpa reduced-motion.
        // rAF mencegah event pointer menulis style tiap frame.
        const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
        if (!reduce && finePointer.matches) {
          const hero = document.getElementById('hero');
          if (hero) {
            let frame = 0;
            let px = 0;
            let py = 0;
            const paint = () => {
              frame = 0;
              hero.style.setProperty('--hero-px', `${px.toFixed(1)}px`);
              hero.style.setProperty('--hero-py', `${py.toFixed(1)}px`);
            };
            hero.addEventListener('pointermove', (event) => {
              const box = hero.getBoundingClientRect();
              px = ((event.clientX - box.left) / box.width - 0.5) * 12;
              py = ((event.clientY - box.top) / box.height - 0.5) * 12;
              if (!frame) frame = window.requestAnimationFrame(paint);
            }, { passive: true });
            hero.addEventListener('pointerleave', () => {
              px = 0;
              py = 0;
              if (!frame) frame = window.requestAnimationFrame(paint);
            }, { passive: true });
          }
        }

        // --- Scroll experience (PRIORITAS 3) ---------------------------------
        // Section masuk sekali lalu observer berhenti. Arah/stagger berasal
        // dari kelas .section-enter di komponen, bukan dari JS.
        const sectionEntries = Array.from(document.querySelectorAll('.section-enter'));
        if (!reduce && 'IntersectionObserver' in window && sectionEntries.length) {
          const sectionObserver = new IntersectionObserver((entries, obs) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              obs.unobserve(entry.target);
            });
          }, { rootMargin: '0px 0px -6% 0px', threshold: 0.08 });
          sectionEntries.forEach((el) => sectionObserver.observe(el));
          window.setTimeout(() => {
            sectionEntries.forEach((el) => {
              if (el.classList.contains('is-visible')) return;
              const box = el.getBoundingClientRect();
              if (box.top < window.innerHeight && box.bottom > 0) {
                el.classList.add('is-visible');
                sectionObserver.unobserve(el);
              }
            });
          }, 1200);
        } else {
          sectionEntries.forEach((el) => el.classList.add('is-visible'));
        }

        // Progress bar, timeline, dan parallax memakai satu scheduler rAF.
        // Observer menyalakan timeline/parallax hanya saat elemen terlihat;
        // progress bar dihitung langsung dari event scroll, bukan loop aktif.
        const timeline = document.querySelector('.timeline');
        const parallaxHost = document.querySelector('[data-parallax-host]');
        const parallaxTarget = document.querySelector('.about__num');
        const progressBar = document.querySelector('.reading-progress');
        const backToTop = document.getElementById('backToTop');
        const ctaCopy = document.getElementById('copyEmailBtn');
        const footer = document.querySelector('.site-footer');
        let timelineActive = false;
        let parallaxActive = false;
        let fxFrame = 0;

        const clamp = (value, min, max) => Math.min(max, Math.max(min, value));
        const paintScrollFx = () => {
          fxFrame = 0;
          // Progres baca adalah informasi, jadi dihitung walau reduced-motion.
          if (progressBar) {
            const travel = document.documentElement.scrollHeight - window.innerHeight;
            const value = travel > 0 ? clamp(window.scrollY / travel, 0, 1) : 0;
            progressBar.style.setProperty('--scroll-progress', value.toFixed(4));
          }
          if (timelineActive && timeline) {
            const box = timeline.getBoundingClientRect();
            const marker = window.innerHeight * 0.6;
            const progress = clamp((marker - box.top) / Math.max(box.height, 1), 0, 1);
            timeline.style.setProperty('--progress', progress.toFixed(3));
          }
          if (parallaxActive && parallaxHost && parallaxTarget) {
            const box = parallaxHost.getBoundingClientRect();
            const vh = window.innerHeight;
            const raw = ((vh - box.top) / (vh + box.height)) * 2 - 1;
            const y = clamp(raw * 12, -12, 12);
            parallaxHost.style.setProperty('--parallax-y', `${y.toFixed(1)}px`);
          }
          // Jalan pintas muncul setelah hero dan menghilang lagi di dekatnya.
          // Saat CTA/footer terlihat, tombol disembunyikan supaya tidak
          // menimpa kedua area itu (R-31). Memakai scheduler yang sama, tanpa
          // loop atau scroll listener baru.
          if (backToTop) {
            const vh = window.innerHeight;
            const overlaps = [ctaCopy, footer].some((el) => {
              if (!el) return false;
              const box = el.getBoundingClientRect();
              return box.top < vh && box.bottom > 0;
            });
            backToTop.classList.toggle('is-visible', window.scrollY > 600 && !overlaps);
          }
        };
        const requestScrollFx = () => {
          if (!fxFrame) fxFrame = window.requestAnimationFrame(paintScrollFx);
        };

        if (!reduce && 'IntersectionObserver' in window) {
          const visibility = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              const active = entry.isIntersecting;
              if (entry.target === timeline) timelineActive = active;
              if (entry.target === parallaxHost) {
                parallaxActive = active && finePointer.matches;
                if (!parallaxActive) parallaxHost?.style.setProperty('--parallax-y', '0px');
              }
            });
            requestScrollFx();
          }, { rootMargin: '10% 0px 10% 0px', threshold: 0 });
          if (timeline) visibility.observe(timeline);
          if (parallaxHost && parallaxTarget && finePointer.matches) {
            visibility.observe(parallaxHost);
          }
        }
        // Satu scheduler rAF untuk semua efek scroll, termasuk progress bar.
        // Tetap aktif saat reduced-motion karena progress bar adalah informasi.
        window.addEventListener('scroll', requestScrollFx, { passive: true });
        window.addEventListener('resize', requestScrollFx, { passive: true });
        requestScrollFx();

        backToTop?.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
          document.querySelector('.wordmark')?.focus({ preventScroll: true });
        });
      })();
    </script>

    <!-- P5: magnetic ringan pada nav desktop. Terpisah dari script utama supaya
         observer, pointer hero, dan state navexisting tidak tersentuh. -->
    <script is:inline>
      (() => {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
        if (reduce || !fine || !document.documentElement.classList.contains('has-motion')) return;
        const targets = Array.from(document.querySelectorAll('[data-magnetic]'));
        if (!targets.length) return;
        let frame = 0;
        let current = null;
        let x = 0;
        let y = 0;
        const paint = () => {
          frame = 0;
          if (!current) return;
          current.style.setProperty('--mag-x', `${x.toFixed(1)}px`);
          current.style.setProperty('--mag-y', `${y.toFixed(1)}px`);
        };
        const reset = (el) => {
          el.style.removeProperty('--mag-x');
          el.style.removeProperty('--mag-y');
        };
        targets.forEach((el) => {
          el.addEventListener('pointermove', (event) => {
            const box = el.getBoundingClientRect();
            x = ((event.clientX - box.left) / box.width - 0.5) * 8;
            y = ((event.clientY - box.top) / box.height - 0.5) * 8;
            // Maksimal 4px per sumbu.
            x = Math.max(-4, Math.min(4, x));
            y = Math.max(-4, Math.min(4, y));
            current = el;
            if (!frame) frame = window.requestAnimationFrame(paint);
          }, { passive: true });
          el.addEventListener('pointerleave', () => {
            if (current === el) current = null;
            reset(el);
          }, { passive: true });
          el.addEventListener('blur', () => {
            if (current === el) current = null;
            reset(el);
          });
        });
      })();
    </script>

    <style is:global>
      /* --- Header: transparan di atas cover terang, putih solid + border
         #DDE1E7 setelah scroll. Teks gelap; satu garis biru menandai active. */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        width: 100%;
        background: transparent;
        border-bottom: 1px solid transparent;
        transition: background-color var(--dur-ui) var(--ease-out),
                    border-color var(--dur-ui) var(--ease-out),
                    opacity 200ms var(--ease-out),
                    transform 200ms var(--ease-out);
      }
      .site-header.is-scrolled {
        background: var(--white);
        border-bottom-color: var(--border);
      }
      .site-header__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        min-height: var(--header-h);
        transition: min-height 180ms var(--ease-out);
      }
      /* Compact mengecilkan tinggi header 8px tanpa mengubah warna/token. */
      .site-header.is-compact .site-header__inner {
        min-height: calc(var(--header-h) - 8px);
      }
      .wordmark {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        min-height: 44px;
        flex-shrink: 0;
      }
      .wordmark__mono {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 38px;
        min-height: 30px;
        padding: 4px 7px;
        border-radius: 4px;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 0.9375rem;
        letter-spacing: -0.05em;
        color: var(--white);
        background: var(--ink);
      }
      .wordmark__name {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 0.875rem;
        letter-spacing: -0.015em;
        color: var(--ink);
      }
      .site-nav { display: none; align-items: center; gap: 4px; position: relative; }
      .site-nav__link {
        position: relative;
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        padding-inline: 14px;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.06em;
        color: var(--muted);
        transition: color var(--dur-ui) var(--ease-out);
      }
      .site-nav__link::after {
        content: "";
        position: absolute;
        left: 14px;
        right: 14px;
        bottom: 10px;
        height: 1px;
        background: var(--accent);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform var(--dur-ui) var(--ease-out);
      }
      .site-nav__link:hover,
      .site-nav__link.is-active { color: var(--ink); }
      /* FLIP hairline menggantikan ::after statis: satu garis biru yang
         meluncur antar link aktif (sumber: hexagoncircle/scrollspy-nav, MIT). */
      .site-nav__link::after { display: none; }
      .site-nav__marker {
        position: absolute;
        bottom: 10px;
        left: 0;
        width: 0;
        height: 1px;
        background: var(--accent);
        pointer-events: none;
        transform-origin: left;
      }

      .site-header__end { display: inline-flex; align-items: center; gap: 12px; }
      .availability {
        display: none;
        align-items: center;
        gap: 8px;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.06em;
        color: var(--muted);
      }
      /* Dot menandakan status nyata (tersedia), bukan dekorasi berdenyut. */
      .availability__dot {
        width: 6px;
        height: 6px;
        background: var(--accent);
        border-radius: 50%;
      }
      @media (min-width: 768px) { .availability { display: inline-flex; } }
      @media (min-width: 900px) {
        .site-nav { display: inline-flex; }
        .mobile-nav { display: none; }
      }

      /* Menu mobile: label terlihat, bukan hamburger tanpa nama. */
      .mobile-nav { position: relative; }
      .mobile-nav > summary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding-inline: 14px;
        border: 1px solid var(--border);
        border-radius: 8px;
        list-style: none;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        color: var(--ink);
      }
      .mobile-nav > summary::-webkit-details-marker { display: none; }
      .mobile-nav[open] > summary { background: var(--secondary-surface); }
      .mobile-nav nav {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        width: min(260px, calc(100vw - 40px));
        display: flex;
        flex-direction: column;
        padding: 6px;
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 8px;
      }
      .mobile-nav nav a {
        display: flex;
        align-items: center;
        min-height: 44px;
        padding-inline: 12px;
        border-radius: 4px;
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        color: var(--ink);
      }
      .mobile-nav nav a:hover { background: var(--secondary-surface); }
      .mobile-nav nav a:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
      .site-nav__link:focus-visible { outline-color: var(--accent); }

      /* Back-to-top: 44px tap target, netral, tanpa shadow/glow. Animasi
         hanya saat has-motion; reduced-motion memakai switch opacity instan. */
      .back-to-top {
        position: fixed;
        right: max(var(--gutter), calc((100vw - var(--page-max)) / 2));
        bottom: max(20px, calc(env(safe-area-inset-bottom, 0px) + 16px));
        z-index: 40;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        padding: 0;
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 8px;
        color: var(--ink);
        cursor: pointer;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }
      .back-to-top.is-visible {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
      }
      html.has-motion .back-to-top {
        transform: translateY(6px);
        transition: opacity 180ms var(--ease-out), transform 180ms var(--ease-out);
      }
      html.has-motion .back-to-top.is-visible { transform: translateY(0); }
      .back-to-top:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
      .back-to-top__arrow {
        position: relative;
        width: 10px;
        height: 10px;
        border-top: 1px solid var(--ink);
        border-left: 1px solid var(--ink);
        transform: translateY(2px) rotate(45deg);
      }

      /* --- Halo & magnetic ringan (Magic UI / React Bits technique, CSS-only) ---
         Satu hairline yang muncul saat hover pada CTA, bukan glow. Gerak hanya
         dengan pointer presisi + has-motion. Reduced-motion dan touch mematikan
         keduanya. Komponen tetap memakai teks asli; dekorasi tidak menyimpan info. */
      .btn::after,
      .text-link::before {
        content: "";
        position: absolute;
        inset: -1px;
        border: 1px solid var(--accent);
        border-radius: inherit;
        opacity: 0;
        pointer-events: none;
      }
      .text-link::before { inset: -3px -4px; border-radius: 2px; }
      .btn { position: relative; }
      @media (prefers-reduced-motion: no-preference) {
        @media (hover: hover) and (pointer: fine) {
          html.has-motion .btn::after,
          html.has-motion .text-link::before {
            transition: opacity 200ms var(--ease-out);
          }
          html.has-motion .btn:hover::after,
          html.has-motion .btn:focus-visible::after,
          html.has-motion .text-link:hover::before,
          html.has-motion .text-link:focus-visible::before { opacity: 0.55; }
          /* Magnetic sangat kecil: max 3px, mengikuti var(--mag-x/y) yang
             sudah dihasilkan script nav yang tidak disentuh di sini. */
          html.has-motion .btn[data-magnetic],
          html.has-motion .text-link[data-magnetic] {
            transform: translate3d(var(--mag-x, 0px), var(--mag-y, 0px), 0);
          }
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .btn::after,
        .text-link::before,
        .btn[data-magnetic],
        .text-link[data-magnetic] {
          opacity: 0 !important;
          transform: none !important;
          transition: none !important;
        }
      }

      main { display: block; }
    </style>
  </body>
</html>
