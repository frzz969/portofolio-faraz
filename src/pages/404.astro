---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found - Faras Fadhil Firdaus"
  description="Halaman tidak ditemukan di portofolio Faras Fadhil Firdaus."
  canonical={new URL(import.meta.env.BASE_URL, 'https://frzz969.github.io').href}
>
  <section class="container notfound charcoal" id="notfound">
    <span class="eyebrow">404 / Not found</span>
    <h1 class="h1 notfound__title">PAGE NOT FOUND.</h1>
    <p class="lead">
      The page you were looking for is not here. You can return to the portfolio homepage.
    </p>
    <!-- BASE_URL sudah mengandung trailing slash di Astro (/portofolio-faraz/). -->
    <a class="btn btn--light notfound__action" href={import.meta.env.BASE_URL}>Back to Home</a>
  </section>
</Layout>

<style>
  .notfound {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding-block: clamp(72px, 12vw, 140px);
  }
  .notfound__title { margin-block: 20px 24px; }
  .notfound__action { margin-top: 32px; }
</style>
